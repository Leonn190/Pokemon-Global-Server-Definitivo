          {
            "condicoes": [
              {
                "alvo": "respeito_atual",
                "op": ">=",
                "valor": 2
              }
            ],
            "valor": "Respeito 2 confirmado. Agora você pode encarar minha formação Planta.\nRespeito 2 permite a batalha. Agora seu time vai descobrir se sabe lutar contra algo que cresce enquanto você se distrai."
          },
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Voltou ao viveiro? Bom. Planta gosta de retorno: folha nova, tentativa nova, erro antigo virando adubo."
          }
        ]
      },
      "opcoes": [
        {
          "texto_condicional": {
            "padrao": "Ainda não tenho respeito 2 para batalhar.",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "Quero desafiar você."
              }
            ]
          },
          "destino_condicional": {
            "padrao": "sem_respeito",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "batalha_liberada"
              }
            ]
          }
        },
        {
          "texto": "Conversar.",
          "destino": "conversa"
        },
        {
          "texto": "Quero entender o presente.",
          "destino": "checar_presente"
        },
        {
          "texto": "Encerrar.",
          "acao": "fim"
        }
      ]
    },
    "sem_respeito": {
      "fala": "Ainda não. Capitão Planta só aceita desafio oficial com respeito 2.\nLilligant não dança por pressa, Tangrowth não solta cipó sem motivo e Rillaboom não marca ritmo para quem ainda não respeitou o campo.",
      "opcoes": [
        {
          "texto": "Então vou buscar mais respeito.",
          "acao": "fim"
        },
        {
          "texto": "Conversar mesmo assim.",
          "destino": "conversa"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "batalha_liberada": {
      "fala_condicional": {
        "padrao": "Meu time cresce em camadas: Lilligant organiza o passo, Whimsicott perturba a rota, Ludicolo mistura chuva e festa, Leafeon corta limpo, Tangrowth prende e Rillaboom comanda o ciclo.",

    "origem": {
      "fala": "Eu escolhi Elétrico porque é o tipo que menos aceita mentira.\nOu tem circuito, ou não tem. Ou conduz, ou isola. Ou você respeita a carga, ou ela te cobra na hora.",
      "ao_entrar": {
        "setor": {
          "OuviuOrigemHelenaVoltz": true
        }
      },
      "opcoes": [
        {
          "texto": "Isso parece palco.",
          "destino": "palco"
        },
        {
          "texto": "Isso parece batalha.",
          "destino": "batalha_teoria"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "palco": {
      "fala": "Palco e arena são quase a mesma coisa: luz, ruído, cabo escondido, gente achando que tudo é mágica.\nA diferença é que na arena o solo pode tentar te derrotar também.",
      "opcoes": [
        {
          "texto": "E o Toxtricity?",
          "destino": "toxtricity"
        },
        {
          "texto": "Voltar.",
          "destino": "origem"
        }
      ]
    },
    "batalha_teoria": {
      "fala": "Batalha elétrica é tempo de resposta. Você cria uma janela menor do que o adversário consegue pensar.\nQuando ele percebe, o choque já virou decisão.",
      "opcoes": [
        {
          "texto": "Então o pulso é central.",
          "destino": "pulso"
        },
        {
          "texto": "Voltar.",
          "destino": "origem"
        }
      ]
    },
    "aterramento": {
      "fala": "Aterramento é humildade elétrica. Toda energia precisa de caminho seguro para voltar.\nNo meu time, Ampharos faz isso: ilumina, estabiliza e impede que a pressa vire curto.",
      "ao_entrar": {
        "setor": {
          "EntendeuAterramentoHelenaVoltz": true
        }
      },
      "opcoes": [
        {
          "texto": "Fala do Ampharos.",
          "destino": "ampharos"
        },
        {
          "texto": "Isso ajuda no presente?",
          "destino": "trava"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "pulso": {
      "fala": "Pulso é repetição com intenção. Galvantula prende o ritmo, Jolteon corta o intervalo e Raichu muda a velocidade do compasso.\nSem pulso, Elétrico vira clarão bonito e nada mais.",
      "ao_entrar": {
        "setor": {
          "EntendeuPulsoHelenaVoltz": true
        }
      },
      "opcoes": [
        {
          "texto": "Fala do Galvantula.",
          "destino": "galvantula"
        },
        {
          "texto": "Fala do Jolteon.",
          "destino": "jolteon"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "descarga": {
      "fala": "Descarga é a decisão final. Não é gastar tudo porque brilhou; é soltar quando o circuito já está fechado.\nManectric e Toxtricity são perigosos por isso: eles não só atacam, eles fecham o ambiente.",
      "ao_entrar": {
        "setor": {
          "EntendeuDescargaHelenaVoltz": true
        }
      },
      "opcoes": [
        {
          "texto": "Fala do Manectric.",
          "destino": "manectric"
        },
        {
          "texto": "Fala do Toxtricity.",
          "destino": "toxtricity"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "trava": {
      "fala": "Meu presente fica atrás de três chaves: aterramento, pulso e descarga.\nQuem aprende só a dar choque ganha batalha curta. Quem entende retorno, ritmo e decisão aguenta a arena inteira.",
      "opcoes": [
        {
          "texto": "Checar presente.",
          "destino": "checar_presente"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "time": {
      "fala": "Raichu inicia rápido. Manectric morde espaço. Galvantula transforma campo em rede. Toxtricity toca sujeira no circuito.\nJolteon é velocidade pura. Ampharos é farol: quando ele acende, a luta fica honesta para mim e perigosa para você.",
      "ao_entrar": {
        "setor": {
          "OuviuTimeHelenaVoltz": true
        }
      },
      "opcoes": [
        {
          "texto": "Fala do Toxtricity.",
          "destino": "toxtricity"
        },
        {
          "texto": "Fala do Ampharos.",
          "destino": "ampharos"
        },
        {
          "texto": "Quero batalhar.",
          "destino_condicional": {
            "padrao": "sem_respeito",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "batalha_liberada"
              }
            ]
          }
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "raichu": {
      "fala": "Raichu começa como faísca esperta: não é o maior brilho, mas sabe onde encostar.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "time"
        }
      ]
    },
    "manectric": {
      "fala": "Manectric é tensão acumulada. Ele faz o adversário sentir que o ar ficou carregado antes do golpe sair.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "descarga"
        }
      ]
    },
    "galvantula": {
      "fala": "Galvantula costura a arena com fio invisível. Quando você acha que está livre, já pisou no compasso dele.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "pulso"
        }
      ]
    },
    "toxtricity": {
      "fala": "Toxtricity é o chiado que vira música. Ele desafina o adversário até o erro parecer escolha.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "descarga"
        },
        {
          "texto": "Voltar ao palco.",
          "destino": "palco"
        }
      ]
    },
    "jolteon": {
      "fala": "Jolteon não espera aplauso. Ele passa, resolve e deixa o barulho chegar depois.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "pulso"
        }
      ]
    },
    "ampharos": {
      "fala": "Ampharos é meu farol. Nem toda luz serve para cegar; algumas servem para lembrar onde está o chão.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "aterramento"
        },
        {
          "texto": "Voltar ao time.",
          "destino": "time"
        }
      ]
    },

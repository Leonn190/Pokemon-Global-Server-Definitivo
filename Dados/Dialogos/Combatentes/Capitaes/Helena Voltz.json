    "pos_batalha_derrota": {
      "fala": "Você perdeu, mas não queimou o circuito.\nRevê seu aterramento e volta. O problema geralmente começa antes do choque.",
      "opcoes": [
        {
          "texto": "Encerrar conversa.",
          "acao": "fim"
        },
        {
          "texto": "Quero uma dica.",
          "destino": "aterramento"

    "presente_negado": {
      "fala": "Ainda não. Meu presente não sai com botão de atalho.\nPrimeiro você precisa fechar o circuito: aterramento, pulso e descarga.",
      "opcoes": [
        {
          "texto": "Me mostra o caminho certo.",
          "destino": "conversa"
        },
        {
          "texto": "Voltar ao começo.",
          "destino": "saudacao"
        },
        {
          "texto": "Deixar para depois.",
          "acao": "fim"
        }
      ]

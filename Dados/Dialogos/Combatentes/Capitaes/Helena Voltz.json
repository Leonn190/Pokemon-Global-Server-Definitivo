  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Helena Voltz na área. Capitã do estádio Elétrico, técnica de palco, DJ quando deixam e fiscal de cabo desencapado por necessidade.\nSe ouvir estalo, não corre: primeiro olha onde pisa.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "respeito_atual",
                "op": ">=",
                "valor": 2
              }
            ],
            "valor": "Respeito 2 na tomada. Agora dá para liberar a batalha.\nPrometo uma descarga limpa: sem gambiarra, sem curto injusto, só pulso e reação."
          },
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Você voltou. Gosto disso.\nO primeiro choque assusta; o segundo ensina ritmo."
          }
        ]
      },
      "opcoes": [
        {
          "texto_condicional": {
            "padrao": "Ainda não tenho respeito 2 para batalhar.",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "Quero a batalha da capitã Elétrica."
              }
            ]
          },
          "destino_condicional": {
            "padrao": "sem_respeito",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "batalha_liberada"
              }
            ]
          }
        },
        {
          "texto": "Quero conversar.",
          "destino": "conversa"
        },
        {
          "texto": "Como funciona seu time?",
          "destino": "time"
        },
        {
          "texto": "Tem algum presente?",
          "destino": "checar_presente"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "sem_respeito": {
      "fala": "Sem respeito 2, nada de batalha oficial.\nEnergia sem disjuntor vira incêndio, e capitão existe justamente para não deixar isso acontecer.",
      "opcoes": [
        {
          "texto": "Conversar primeiro.",
          "destino": "conversa"
        },
        {
          "texto": "Voltar depois.",
          "acao": "fim"
        }
      ]
    },
    "batalha_liberada": {
      "fala_condicional": {
        "padrao": "Minha batalha é pulso: Raichu acelera, Manectric pressiona, Galvantula prende, Toxtricity bagunça o ritmo, Jolteon passa como faísca e Ampharos ilumina o fim.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "respeito_atual",
                "op": ">=",
                "valor": 4
              }
            ],
            "valor": "Com esse respeito todo, eu posso aumentar a voltagem sem te explicar onde fica o botão de emergência."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Começar batalha.",
          "acao": "batalha",
          "batalha": 1,
          "ao_escolher": {
            "setor": {
              "TentouBatalhaHelenaVoltz": {
                "op": "add",
                "valor": 1
              }
            }
          }
        },
        {
          "texto": "Quero conversar antes.",
          "destino": "conversa"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "conversa": {
      "fala_condicional": {
        "padrao": "Fala rápido ou fala no ritmo; eu acompanho os dois.\nSó não fala atravessado em cima do pulso, porque até conversa desafina.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.ConversasHelenaVoltz",
                "op": ">=",
                "valor": 2
              }
            ],
            "valor": "Você já está pegando o compasso da arena.\nDaqui a pouco eu te boto para revisar cabo comigo."
          }
        ]
      },
      "ao_entrar": {
        "setor": {
          "FalouComHelenaVoltz": true,
          "ConversasHelenaVoltz": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "Por que Elétrico?",
          "destino": "origem"
        },
        {
          "texto": "Me explica aterramento.",
          "destino": "aterramento"
        },
        {
          "texto": "Me explica pulso.",
          "destino": "pulso"
        },
        {
          "texto": "Me explica descarga.",
          "destino": "descarga"
        },
        {
          "texto": "Quero entender o presente.",
          "destino": "checar_presente"
        },
        {
          "texto": "Quero batalhar.",
          "destino_condicional": {
            "padrao": "sem_respeito",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "batalha_liberada"
              }
            ]
          }
        },
        {
          "texto": "Encerrar.",
          "acao": "fim"
        }
      ]

    "presente_negado": {
      "fala": "Ainda não. Eu não entrego frasco para quem só gostou da caveirinha no rótulo.\nAprenda dose, tempo e antídoto. Depois a caixa abre.",
      "opcoes": [
        {
          "texto": "Me mostra o caminho certo.",
          "destino": "conversa"
        },
        {
          "texto": "Voltar ao começo.",
          "destino": "saudacao"
        },
        {
          "texto": "Deixar para depois.",
          "acao": "fim"
        }
      ]
    },

            "padrao": "sem_respeito",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "batalha_liberada"
              }
            ]
          }
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "salazzle": {
      "fala": "Salazzle sabe que veneno também pode ser conversa bonita no momento errado.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "dose"
        }
      ]
    },
    "toxicroak": {
      "fala": "Toxicroak é o aviso para quem acha que encostar resolve tudo. Às vezes o contato é exatamente o erro.",

        "setor": {
          "OuviuTimeNadiaVibora": true
        }
      },
      "opcoes": [
        {
          "texto": "Fala do Drapion.",
          "destino": "drapion"
        },
        {
          "texto": "Fala do Muk.",
          "destino": "muk"
        },
        {
          "texto": "Quero batalhar.",

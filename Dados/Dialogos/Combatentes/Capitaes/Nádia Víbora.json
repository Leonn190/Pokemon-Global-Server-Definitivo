  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Eu sou Nádia Víbora, capitã do estádio Venenoso.\nPode respirar. Se eu quisesse te envenenar na entrada, você já estaria negociando com o chão.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "respeito_atual",
                "op": ">=",
                "valor": 2
              }
            ],
            "valor": "Respeito 2 confirmado. A batalha está liberada.\nAgora sim posso testar se você sabe diferenciar ameaça real de perfume amargo."
          },
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Voltou sem trazer antídoto? Corajoso.\nOu confiante demais. Os dois são materiais úteis para teste."
          }
        ]
      },
      "opcoes": [
        {
          "texto_condicional": {
            "padrao": "Ainda não tenho respeito 2 para batalhar.",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "Quero a batalha da capitã Venenosa."
              }
            ]
          },
          "destino_condicional": {
            "padrao": "sem_respeito",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "batalha_liberada"
              }
            ]
          }
        },
        {
          "texto": "Quero conversar.",
          "destino": "conversa"
        },
        {
          "texto": "Como funciona seu time?",
          "destino": "time"
        },
        {
          "texto": "Tem algum presente?",
          "destino": "checar_presente"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "sem_respeito": {
      "fala": "Sem respeito 2, nada de batalha oficial.\nVenenoso exige controle. Quem pula etapa costuma confundir dose com desastre.",
      "opcoes": [
        {
          "texto": "Conversar primeiro.",
          "destino": "conversa"
        },
        {
          "texto": "Voltar depois.",
          "acao": "fim"
        }
      ]
    },
    "batalha_liberada": {
      "fala_condicional": {
        "padrao": "Minha batalha é dose, tempo e acúmulo.\nSalazzle seduz a atenção, Toxicroak ameaça contato, Drapion fecha rota, Toxapex aguenta o mundo, Scolipede acelera e Muk transforma o fim em lama.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "respeito_atual",
                "op": ">=",
                "valor": 4
              }
            ],
            "valor": "Com respeito alto, eu posso ser direta: se você tratar veneno como dano comum, já perdeu metade da luta."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Começar batalha.",
          "acao": "batalha",
          "batalha": 1,
          "ao_escolher": {
            "setor": {
              "TentouBatalhaNadiaVibora": {
                "op": "add",
                "valor": 1
              }
            }
          }
        },
        {
          "texto": "Quero conversar antes.",
          "destino": "conversa"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "conversa": {
      "fala_condicional": {
        "padrao": "Pode perguntar. Só não toca nos frascos sem ler etiqueta.\nO verde claro cura, o verde escuro provavelmente cura também, mas depois de piorar sua semana.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.ConversasNadiaVibora",
                "op": ">=",
                "valor": 2
              }
            ],
            "valor": "Você voltou e ainda está inteiro.\nIsso coloca você acima de muitos curiosos do estádio."
          }
        ]
      },
      "ao_entrar": {
        "setor": {
          "FalouComNadiaVibora": true,
          "ConversasNadiaVibora": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "Por que Venenoso?",
          "destino": "origem"
        },
        {
          "texto": "Me explica dose.",
          "destino": "dose"
        },
        {
          "texto": "Me explica tempo.",
          "destino": "tempo"
        },
        {
          "texto": "Me explica antídoto.",
          "destino": "antidoto"
        },
        {
          "texto": "Quero entender o presente.",
          "destino": "checar_presente"
        },
        {
          "texto": "Quero batalhar.",
          "destino_condicional": {
            "padrao": "sem_respeito",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "respeito_atual",
                    "op": ">=",
                    "valor": 2
                  }
                ],
                "valor": "batalha_liberada"
              }
            ]
          }
        },
        {
          "texto": "Encerrar.",
          "acao": "fim"
        }
      ]

        {
          "texto": "Voltar.",
          "destino": "time"
        }
      ]
    },
    "drapion": {
      "fala": "Drapion é porta fechada com pinça. Ele não precisa correr se o caminho já é dele.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "time"
        }
      ]
    },
    "toxapex": {
      "fala": "Toxapex é paciência cruel. Ele não tem pressa porque sabe que o outro lado está gastando ar.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "tempo"
        }
      ]
    },
    "scolipede": {
      "fala": "Scolipede lembra que veneno também pode ser velocidade. Às vezes a toxina chega antes da dúvida.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "tempo"
        }
      ]
    },
    "muk": {
      "fala": "Muk é o que sobra quando o adversário tenta varrer consequência para baixo do tapete.",
      "opcoes": [
        {
          "texto": "Voltar.",
          "destino": "time"
        }
      ]
    },

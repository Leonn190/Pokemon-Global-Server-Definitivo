            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Você voltou ao salão das escamas.\nBom. O primeiro encontro mostra coragem; o segundo mostra interesse."
          }

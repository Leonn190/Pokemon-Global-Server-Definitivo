{
  "inicio": "saudacao",
  "pos_batalha": {
    "vitoria": "pos_batalha_vitoria",
    "derrota": "pos_batalha_derrota",
    "padrao": "pos_batalha_derrota"
  },
  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Eu sou Alice Ferraz, desafiante do estádio Metal. Meu time ainda é pequeno, mas cada peça já aprendeu a não tremer no encaixe.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "respeito_atual",
                "op": ">=",
                "valor": 2
              }
            ],
            "valor": "Você já tem respeito no Metal. Então eu não vou fingir que isso é só treino: quero testar se sua estrutura aguenta pressão de verdade."
          },
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Voltou? Bom. Metal não melhora em um único impacto; ele melhora quando a pancada vira forma."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Quero batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Conversar primeiro.",
          "destino": "conversa"
        },
        {
          "texto": "Falar do seu time.",
          "destino": "time"
        },
        {
          "texto": "Alguma dica rápida?",
          "destino": "checar_dica"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "conversa": {
      "fala": "Eu gosto de batalhas limpas. Se uma engrenagem gira torta, o problema aparece no time inteiro.",
      "ao_entrar": {
        "setor": {
          "FalouComAliceFerraz": true,
          "AliceFerrazConversas": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "O que você valoriza em batalha?",
          "destino": "valor"
        },
        {
          "texto": "Você conhece alguém do estádio?",
          "destino": "citacao"
        },
        {
          "texto": "Vamos batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "valor": {
      "fala": "Para mim, Metal é ajuste fino. Bronzor segura, Ferroseed incomoda, Aron aprende a ficar de pé, Klink marca ritmo, Magnemite pressiona e Pawniard corta o erro.",
      "ao_entrar": {
        "setor": {
          "EntendeuAliceFerraz": true
        }
      },
      "opcoes": [
        {
          "texto": "Agora entendi sua lógica.",
          "destino": "dica_aprendida"
        },
        {
          "texto": "Quero enfrentar isso.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "time": {
      "fala": "Meu time é Bronzor, Ferroseed, Aron, Klink, Magnemite, Pawniard. Não é um grupo perfeito, mas cada um tem uma função dentro do meu jeito Metal de lutar.",
      "opcoes": [
        {
          "texto": "Como você usa esse time?",
          "destino": "valor"
        },
        {
          "texto": "Vou testar esse time na batalha.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "citacao": {
      "fala": "O capitão Caio Ferraz fala como se cada frase fosse uma ferramenta. Eu tento aprender isso, mas ainda deixo algumas rebarbas.",
      "opcoes": [
        {
          "texto": "Boa referência.",
          "destino": "conversa"
        },
        {
          "texto": "Chega de conversa. Batalha.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Encerrar.",
          "acao": "fim"
        }
      ]
    },
    "checar_dica": {
      "desvio_condicional": {
        "padrao": "dica_basica",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.EntendeuAliceFerraz",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "dica_aprendida"
          }
        ]
      },
      "opcoes": []
    },
    "dica_basica": {
      "fala": "Minha dica é simples: não bata no primeiro brilho que aparecer. Às vezes ele é isca, às vezes é parede.",
      "opcoes": [
        {
          "texto": "Vou lembrar disso.",
          "destino": "saudacao"
        },
        {
          "texto": "Então vamos lutar.",
          "acao": "batalha",
          "batalha": 1
        }
      ]
    },
    "dica_aprendida": {
      "fala": "Você percebeu o padrão. Contra Metal, ganhar não é só causar dano; é não deixar a defesa virar trilho para o contra-ataque.",
      "opcoes": [
        {
          "texto": "Agora quero batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar ao início.",
          "destino": "saudacao"
        }
      ]
    },
    "pos_batalha_vitoria": {
      "fala": "Você venceu. Foi como ver uma chapa ceder no ponto certo: não por fraqueza, mas por cálculo melhor.",
      "opcoes": [
        {
          "texto": "Encerrar conversa.",
          "acao": "fim"
        },
        {
          "texto": "Conversar mais um pouco.",
          "destino": "conversa"
        }
      ]
    },
    "pos_batalha_derrota": {
      "fala": "Você perdeu. Não é vergonha. Até aço precisa ser reaquecido antes de tomar forma.",
      "opcoes": [
        {
          "texto": "Encerrar conversa.",
          "acao": "fim"
        },
        {
          "texto": "Pedir uma dica antes de ir.",
          "destino": "checar_dica"
        }
      ]
    },
    "fallback": {
      "fala": "Não consegui abrir o diálogo de Alice Ferraz.",
      "opcoes": [
        {
          "texto": "Fechar.",
          "acao": "fim"
        }
      ]
    }
  }
}

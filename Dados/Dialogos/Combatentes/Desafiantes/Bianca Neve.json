{
  "inicio": "saudacao",
  "pos_batalha": {
    "vitoria": "pos_batalha_vitoria",
    "derrota": "pos_batalha_derrota",
    "padrao": "pos_batalha_derrota"
  },
  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Eu sou Bianca Neve, desafiante do estádio Gelo. Meu time parece fofo, mas gelo bonito também faz escorregar.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "respeito_atual",
                "op": ">=",
                "valor": 2
              }
            ],
            "valor": "Você já tem respeito no Gelo. Então não vou te tratar como turista olhando neve pela primeira vez."
          },
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Você voltou. Trouxe casaco ou trouxe coragem?"
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Quero batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Conversar primeiro.",
          "destino": "conversa"
        },
        {
          "texto": "Falar do seu time.",
          "destino": "time"
        },
        {
          "texto": "Alguma dica rápida?",
          "destino": "checar_dica"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "conversa": {
      "fala": "Eu gosto de batalhas pacientes. Quem se irrita primeiro costuma pisar onde não devia.",
      "ao_entrar": {
        "setor": {
          "FalouComBiancaNeve": true,
          "BiancaNeveConversas": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "O que você valoriza em batalha?",
          "destino": "valor"
        },
        {
          "texto": "Você conhece alguém do estádio?",
          "destino": "citacao"
        },
        {
          "texto": "Vamos batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "valor": {
      "fala": "Snom ensina delicadeza, Swinub fareja caminho, Spheal gira a maré fria, Snorunt observa, Cubchoo resiste e Vanillite lembra que aparência engana.",
      "ao_entrar": {
        "setor": {
          "EntendeuBiancaNeve": true
        }
      },
      "opcoes": [
        {
          "texto": "Agora entendi sua lógica.",
          "destino": "dica_aprendida"
        },
        {
          "texto": "Quero enfrentar isso.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "time": {
      "fala": "Meu time é Snom, Swinub, Spheal, Snorunt, Cubchoo, Vanillite. Não é um grupo perfeito, mas cada um tem uma função dentro do meu jeito Gelo de lutar.",
      "opcoes": [
        {
          "texto": "Como você usa esse time?",
          "destino": "valor"
        },
        {
          "texto": "Vou testar esse time na batalha.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "citacao": {
      "fala": "Isabela Geada diz que eu sorrio demais para alguém do Gelo. Eu acho que isso deixa a queda mais inesperada.",
      "opcoes": [
        {
          "texto": "Boa referência.",
          "destino": "conversa"
        },
        {
          "texto": "Chega de conversa. Batalha.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Encerrar.",
          "acao": "fim"
        }
      ]
    },
    "checar_dica": {
      "desvio_condicional": {
        "padrao": "dica_basica",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.EntendeuBiancaNeve",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "dica_aprendida"
          }
        ]
      },
      "opcoes": []
    },
    "dica_basica": {
      "fala": "Minha dica: não confunda calma com falta de plano. O gelo trabalha enquanto você fala.",
      "opcoes": [
        {
          "texto": "Vou lembrar disso.",
          "destino": "saudacao"
        },
        {
          "texto": "Então vamos lutar.",
          "acao": "batalha",
          "batalha": 1
        }
      ]
    },
    "dica_aprendida": {
      "fala": "Você entendeu: se perder tração, todo golpe forte vira tropeço.",
      "opcoes": [
        {
          "texto": "Agora quero batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar ao início.",
          "destino": "saudacao"
        }
      ]
    },
    "pos_batalha_vitoria": {
      "fala": "Você venceu. Quebrou o gelo antes de eu fechar a pista.",
      "opcoes": [
        {
          "texto": "Encerrar conversa.",
          "acao": "fim"
        },
        {
          "texto": "Conversar mais um pouco.",
          "destino": "conversa"
        }
      ]
    },
    "pos_batalha_derrota": {
      "fala": "Você perdeu. Eu avisei: às vezes a superfície lisa é a parte perigosa.",
      "opcoes": [
        {
          "texto": "Encerrar conversa.",
          "acao": "fim"
        },
        {
          "texto": "Pedir uma dica antes de ir.",
          "destino": "checar_dica"
        }
      ]
    },
    "fallback": {
      "fala": "Não consegui abrir o diálogo de Bianca Neve.",
      "opcoes": [
        {
          "texto": "Fechar.",
          "acao": "fim"
        }
      ]
    }
  }
}

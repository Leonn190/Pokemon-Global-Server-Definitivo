        "setor": {
          "FalouComClaraCampos": true,
          "ClaraCamposConversas": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "O que você valoriza em batalha?",
          "destino": "valor"
        },
        {
          "texto": "Você conhece alguém do estádio?",
          "destino": "citacao"
        },
        {
          "texto": "Vamos batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "valor": {
      "fala": "Eu valorizo constância: Rattata entra sem medo, Teddiursa segura, Lillipup acompanha, Zigzagoon improvisa, Sentret observa e Skitty bagunça o ritmo.",
      "ao_entrar": {
        "setor": {
          "EntendeuClaraCampos": true
        }
      },
      "opcoes": [
        {
          "texto": "Agora entendi sua lógica.",
          "destino": "dica_aprendida"
        },
        {
          "texto": "Quero enfrentar isso.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "time": {
      "fala": "Meu time é Rattata, Teddiursa, Lillipup, Zigzagoon, Sentret, Skitty. Eles têm cara de começo de jornada, e é exatamente isso que eu gosto: um começo bem cuidado vira base para todo o resto.",
      "opcoes": [
        {
          "texto": "Como você usa esse time?",
          "destino": "valor"
        },
        {
          "texto": "Vou testar esse time na batalha.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "citacao": {
      "fala": "A capitã Nora Campos fala que o básico não é simples; é aquilo que continua funcionando quando acaba o espetáculo. Suriane também parece pensar assim.",
      "opcoes": [
        {
          "texto": "Boa referência.",
          "destino": "conversa"
        },
        {
          "texto": "Chega de conversa. Batalha.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Encerrar.",
          "acao": "fim"
        }
      ]
    },
    "checar_dica": {
      "desvio_condicional": {
        "padrao": "dica_basica",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.EntendeuClaraCampos",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "dica_aprendida"
          }
        ]
      },
      "opcoes": []
    },
    "dica_basica": {
      "fala": "Minha dica: contra Normal, não espere uma grande surpresa. O perigo é perder para algo que você achou simples demais.",
      "opcoes": [
        {
          "texto": "Vou lembrar disso.",
          "destino": "saudacao"
        },
        {
          "texto": "Então vamos lutar.",
          "acao": "batalha",
          "batalha": 1
        }
      ]
    },
    "dica_aprendida": {
      "fala": "Você entendeu meu básico. Contra Normal, cada troca pequena conta, porque a força vem da soma e não de um truque só.",
      "opcoes": [
        {
          "texto": "Agora quero batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar ao início.",
          "destino": "saudacao"
        }
      ]
    },
    "pos_batalha_vitoria": {
      "fala": "Você venceu. Seu básico ficou mais firme que o meu, e isso eu respeito muito.",
      "opcoes": [
        {
          "texto": "Encerrar conversa.",
          "acao": "fim"
        },
        {
          "texto": "Conversar mais um pouco.",
          "destino": "conversa"
        }
      ]
    },
    "pos_batalha_derrota": {
      "fala": "Você perdeu. Foi sem mistério: passo certo, golpe certo, tempo certo.",
      "opcoes": [
        {
          "texto": "Encerrar conversa.",
          "acao": "fim"
        },
        {
          "texto": "Pedir uma dica antes de ir.",
          "destino": "checar_dica"
        }
      ]
    },
    "fallback": {
      "fala": "Não consegui abrir o diálogo de Clara Campos.",
      "opcoes": [
        {
          "texto": "Fechar.",
          "acao": "fim"
        }
      ]
    }

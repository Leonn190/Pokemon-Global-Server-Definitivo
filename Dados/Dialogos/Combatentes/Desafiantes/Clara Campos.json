          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Voltou? Que bom. Eu gosto de gente que aparece de novo; rotina também é uma forma de coragem."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Quero batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Conversar primeiro.",
          "destino": "conversa"
        },
        {
          "texto": "Falar do seu time.",
          "destino": "time"
        },
        {
          "texto": "Alguma dica rápida?",
          "destino": "checar_dica"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "conversa": {
      "fala": "Eu gosto de batalhas honestas. Normal não precisa provar que é exótico; precisa mostrar que consistência também vence.",

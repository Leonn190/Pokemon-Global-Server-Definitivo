          {
            "condicoes": [
              {
                "alvo": "respeito_atual",
                "op": ">=",
                "valor": 2
              }
            ],
            "valor": "Você já tem respeito no Normal. Então vou batalhar com o básico bem feito, sem firula para esconder erro."

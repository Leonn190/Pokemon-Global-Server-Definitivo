          "destino": "conversa"
        },
        {
          "texto": "Falar do seu time.",
          "destino": "time"
        },
        {
          "texto": "Alguma dica rápida?",
          "destino": "checar_dica"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]

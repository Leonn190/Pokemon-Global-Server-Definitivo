        "setor": {
          "EntendeuRaviChamas": true
        }
      },
      "opcoes": [
        {
          "texto": "Agora entendi sua lógica.",
          "destino": "dica_aprendida"
        },
        {
          "texto": "Quero enfrentar isso.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "time": {
      "fala": "Meu time é Magby, Vulpix, Torchic, Chimchar, Tepig, Litten. Não é um grupo perfeito, mas cada um tem uma função dentro do meu jeito Fogo de lutar.",
      "opcoes": [
        {
          "texto": "Como você usa esse time?",
          "destino": "valor"
        },
        {
          "texto": "Vou testar esse time na batalha.",
          "acao": "batalha",
          "batalha": 1

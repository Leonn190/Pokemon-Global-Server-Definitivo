    "citacao": {
      "fala": "Dante Brasa fala que fogo sem controle só suja a cozinha. Garcia fala menos, mas queima mais. Eu fico no meio.",
      "opcoes": [
        {
          "texto": "Boa referência.",
          "destino": "conversa"
        },
        {
          "texto": "Chega de conversa. Batalha.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Encerrar.",
          "acao": "fim"
        }
      ]

            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "O que você valoriza em batalha?",
          "destino": "valor"
        },
        {
          "texto": "Você conhece alguém do estádio?",
          "destino": "citacao"
        },
        {
          "texto": "Vamos batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "valor": {
      "fala": "Magby esquenta rápido, Vulpix engana bonito, Torchic acelera, Chimchar improvisa, Tepig empurra e Litten encara como se já tivesse vencido.",

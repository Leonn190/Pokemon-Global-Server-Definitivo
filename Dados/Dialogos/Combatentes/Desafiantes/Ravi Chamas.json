      "opcoes": []
    },
    "dica_basica": {
      "fala": "Minha dica: não espere eu ficar forte para reagir. Fogo pequeno cresce se você deixar ar.",
      "opcoes": [
        {
          "texto": "Vou lembrar disso.",
          "destino": "saudacao"
        },
        {
          "texto": "Então vamos lutar.",
          "acao": "batalha",
          "batalha": 1
        }
      ]
    },
    "dica_aprendida": {
      "fala": "Você percebeu: contra Fogo, cada turno livre vira combustível.",
      "opcoes": [
        {
          "texto": "Agora quero batalhar.",
          "acao": "batalha",
          "batalha": 1
        },
        {
          "texto": "Voltar ao início.",
          "destino": "saudacao"
        }
      ]

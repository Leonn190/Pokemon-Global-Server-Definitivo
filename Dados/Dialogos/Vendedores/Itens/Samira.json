        "casos": [
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Você voltou. Se lembra da ordem? Frasco fosco, pano limpo, tampa morna, conta baixa, palavra certa."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Abrir a loja.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Conversar sobre a reserva de cuidado.",
          "destino": "trilha_intro"
        },
        {
          "texto": "Quero a loja secreta.",
          "destino": "pergunta_secreta"
        },
        {
          "texto": "Tem presente para mim?",
          "destino": "checar_presente"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },

        "setor": {
          "Samira_IniciouTrilha": true,
          "Samira_Passos": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "Observar o frasco fosco.",
          "destino": "frasco_fosco"
        },
        {
          "texto": "Pular direto para o segredo.",
          "destino": "pergunta_secreta"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },

          {
            "condicoes": [
              {
                "alvo": "setor.Clarice.LinhaVazia",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "No rodape, Clarice deixou tres iniciais: C, L e R. Conta, Leitura, Reserva."

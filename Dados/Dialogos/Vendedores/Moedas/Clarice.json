          {
            "condicoes": [
              {
                "alvo": "setor.Clarice.Contexto",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "A aba silencio completa o contexto: quem entende o valor fala pouco e escolhe melhor."
          }
        ]
      },
      "ao_entrar": {
        "setor": {
          "Clarice.AbaSilencio": true
        }

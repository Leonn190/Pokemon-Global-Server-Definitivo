      "opcoes": [
        {
          "texto": "Procurar a linha vazia.",
          "destino": "linha_vazia"
        },
        {
          "texto": "Falar alto sobre a loja secreta.",
          "destino": "alto_errado"
        },
        {
          "texto": "Voltar ao livro.",
          "destino": "livro_intro"
        }
      ]

        {
          "texto": "Conta.",
          "destino": "conta"
        },
        {
          "texto": "Leitura.",
          "destino": "leitura"
        },
        {
          "texto": "Reserva.",
          "destino": "reserva_cedo"
        },
        {
          "texto": "Voltar ao livro.",
          "destino": "livro_intro"
        }

        "setor": {
          "Clarice.LivroAberto": true
        }
      },
      "opcoes": [
        {
          "texto": "Entrada.",
          "destino": "aba_entrada"
        },
        {
          "texto": "Saida.",
          "destino": "aba_saida"
        },
        {
          "texto": "Perda.",
          "destino": "aba_perda"
        },
        {
          "texto": "Ganho.",
          "destino": "aba_ganho"
        },
        {
          "texto": "Silencio.",
          "destino": "aba_silencio"
        },
        {
          "texto": "Rodape.",
          "destino": "aba_rodape"
        }
      ]
    },
    "aba_entrada": {
      "fala": "Entrada mostra quem chegou, mas nao mostra quem mereceu entrar.",
      "opcoes": [
        {
          "texto": "Olhar ganho.",
          "destino": "aba_ganho"
        },
        {
          "texto": "Olhar silencio.",
          "destino": "aba_silencio"
        },
        {
          "texto": "Voltar ao livro.",
          "destino": "livro_intro"
        }
      ]
    },
    "aba_saida": {
      "fala": "Saida mostra quem foi embora. Segredo nenhum espera na porta.",
      "opcoes": [
        {
          "texto": "Olhar ganho.",
          "destino": "aba_ganho"
        },
        {
          "texto": "Olhar rodape.",
          "destino": "aba_rodape"
        },
        {
          "texto": "Voltar ao livro.",
          "destino": "livro_intro"
        }
      ]
    },
    "aba_perda": {
      "fala": "Perda existe, mas hoje e uma aba falsa. Clarice observa se voce percebe.",
      "opcoes": [
        {
          "texto": "Voltar ao livro.",
          "destino": "livro_intro"
        },
        {
          "texto": "Olhar silencio.",
          "destino": "aba_silencio"
        }
      ]
    },
    "aba_ganho": {
      "fala": "Ganho tem uma anotacao: 'valor sem contexto vira barulho'.",
      "ao_entrar": {
        "setor": {
          "Clarice.AbaGanho": true
        }
      },
      "opcoes": [
        {
          "texto": "Procurar o contexto.",
          "destino": "contexto"
        },
        {
          "texto": "Pedir o ganho como presente.",
          "destino": "presente_cedo"
        },
        {
          "texto": "Voltar ao livro.",
          "destino": "livro_intro"
        }
      ]
    },
    "presente_cedo": {
      "fala": "Clarice toca a capa do livro. Presente pedido cedo vira anotacao negativa.",
      "opcoes": [
        {
          "texto": "Procurar o contexto.",
          "destino": "contexto"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "contexto": {
      "fala": "Contexto aparece quando voce cruza ganho com silencio. Quem lucra falando demais perde acesso.",

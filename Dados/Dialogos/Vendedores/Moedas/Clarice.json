      "opcoes": [
        {
          "texto": "Cruzar com silencio.",
          "destino": "aba_silencio"
        },
        {
          "texto": "Cruzar com entrada.",
          "destino": "entrada_errada"
        },
        {
          "texto": "Cruzar com saida.",
          "destino": "saida_errada"
        }
      ]
    },
    "entrada_errada": {
      "fala": "Entrada registra presenca, nao criterio.",
      "opcoes": [
        {
          "texto": "Cruzar com silencio.",
          "destino": "aba_silencio"
        },
        {
          "texto": "Voltar ao livro.",
          "destino": "livro_intro"
        }
      ]
    },
    "saida_errada": {
      "fala": "Saida registra ausencia, nao confianca.",
      "opcoes": [
        {
          "texto": "Cruzar com silencio.",
          "destino": "aba_silencio"
        },
        {
          "texto": "Voltar ao livro.",
          "destino": "livro_intro"
        }
      ]

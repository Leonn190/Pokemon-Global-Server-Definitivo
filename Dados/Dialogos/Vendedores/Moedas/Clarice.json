{
  "inicio": "saudacao",
  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Clarice fecha um livro de contas antes de falar. Loja comum fica aberta; o resto depende de leitura fina.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Voce voltou. Bom. Certos capitulos so aparecem para quem relê."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Abrir a loja.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Ler o livro de contas.",
          "destino": "livro_intro"
        },
        {
          "texto": "Perguntar pela loja secreta.",
          "destino": "checar_loja_secreta"
        },
        {
          "texto": "Perguntar por presente.",
          "destino": "checar_presente"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "loja_padrao": {
      "fala": "A loja comum esta aqui. Compras simples nao precisam de interpretacao.",
      "saida": "loja",
      "opcoes": [
        {
          "texto": "Fechar conversa.",
          "acao": "fim"
        }
      ]
    },
    "livro_intro": {
      "fala": "O livro tem seis abas: entrada, saida, perda, ganho, silencio e rodape. Duas sao falsas, quatro importam.",

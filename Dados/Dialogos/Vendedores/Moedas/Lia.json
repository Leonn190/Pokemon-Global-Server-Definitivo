{
  "inicio": "saudacao",
  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Oi. Eu sou Lia. Moedas fazem um som bonito quando caem no lugar certo. Minha loja comum está aberta; o eco escondido exige ouvido melhor.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Você voltou. Reconheço esse passo. Quer comprar, ouvir o eco ou tentar achar o compartimento silencioso?"
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Abrir a loja.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Ouvir o eco das moedas.",
          "destino": "conversa_eco"
        },
        {
          "texto": "Procurar compartimento secreto.",
          "destino": "pergunta_compartimento"
        },
        {
          "texto": "Perguntar sobre presente.",
          "destino": "checar_presente"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "loja_padrao": {
      "fala": "Aqui está a parte que faz som alto. Pode olhar sem mistério.",
      "saida": "loja",
      "opcoes": [
        {
          "texto": "Fechar conversa.",
          "acao": "fim"
        }
      ]
    },
    "conversa_eco": {
      "fala": "Algumas pessoas só escutam preço. Outras escutam intenção. O eco muda quando alguém pergunta por curiosidade ou por respeito.",
      "ao_entrar": {
        "setor": {
          "LiaConversa": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "Como escutar do jeito certo?",
          "destino": "escuta_certa"
        },
        {
          "texto": "Prefiro a loja comum.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "escuta_certa": {
      "fala": "Não pergunte 'o que você esconde?'. Pergunte 'o que ainda não fez som?'. É menos invasivo e muito mais preciso.",
      "ao_entrar": {
        "setor": {
          "LiaSabePergunta": true
        }
      },
      "opcoes": [
        {
          "texto": "O que ainda não fez som?",
          "destino": "sino_baixo"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "sino_baixo": {
      "fala": "Agora sim. Existe uma gaveta com feltro no fundo. Ela não tilinta quando abre.",
      "ao_entrar": {
        "setor": {
          "LiaOuviuGaveta": true
        }
      },
      "opcoes": [
        {
          "texto": "Abrir essa gaveta silenciosa.",
          "destino": "checar_loja_secreta"
        },
        {
          "texto": "E o presente também fica nela?",
          "destino": "pista_presente"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "pergunta_compartimento": {
      "fala_condicional": {
        "padrao": "Você ouviu falar do compartimento, mas ainda não ouviu o som certo. Comece pelo eco.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.LiaOuviuGaveta",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "Você ouviu o silêncio da gaveta. Posso abrir sem fazer barulho."
          }
        ]
      },
      "ao_entrar": {
        "setor": {
          "LiaPerguntouCompartimento": true
        }
      },
      "opcoes": [
        {
          "texto_condicional": {
            "padrao": "Ouvir o eco primeiro.",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "setor.LiaOuviuGaveta",
                    "op": "==",
                    "valor": true
                  }
                ],
                "valor": "Abrir loja secreta."
              }
            ]
          },
          "destino_condicional": {
            "padrao": "conversa_eco",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "setor.LiaOuviuGaveta",
                    "op": "==",
                    "valor": true
                  }
                ],
                "valor": "checar_loja_secreta"
              }
            ]
          }
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "checar_loja_secreta": {
      "desvio_condicional": {
        "padrao": "loja_secreta_bloqueada",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.LiaSabePergunta",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.LiaOuviuGaveta",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "loja_secreta"
          }
        ]
      },
      "opcoes": []
    },
    "loja_secreta_bloqueada": {
      "fala": "Ainda está fazendo barulho demais. Ouça o eco antes de puxar a gaveta.",
      "opcoes": [
        {
          "texto": "Ouvir o eco.",
          "destino": "conversa_eco"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "loja_secreta": {
      "fala": "Pronto. A gaveta abriu sem tilintar. Veja rápido, antes que o som volte.",
      "saida": "loja_secreta",
      "opcoes": [
        {
          "texto": "Fechar.",
          "acao": "fim"
        }
      ]
    },
    "pista_presente": {
      "fala": "O presente fica perto, mas não é a mesma gaveta. Ele só aparece para quem escutou o silêncio e não tentou forçar a tampa.",
      "ao_entrar": {
        "setor": {
          "LiaPistaPresente": true
        }
      },
      "opcoes": [
        {
          "texto": "Eu escutei o silêncio.",
          "destino": "checar_presente"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "checar_presente": {
      "desvio_condicional": {
        "padrao": "presente_negado",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.LiaOuviuGaveta",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.LiaPistaPresente",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.LiaConversa",
                "op": ">=",
                "valor": 1
              }
            ],
            "valor": "presente_liberado"
          }
        ]
      },
      "opcoes": []
    },
    "presente_negado": {
      "fala": "Ainda não. Seu pedido chegou antes do eco. Volte pela conversa, não pela pressa.",
      "opcoes": [
        {
          "texto": "Ouvir o eco.",
          "destino": "conversa_eco"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "presente_liberado": {
      "fala": "Agora o som encaixou. Pegue isto. É pequeno, mas caiu no lugar certo.",
      "saida": "presente_1",
      "opcoes": [
        {
          "texto": "Obrigado.",
          "acao": "fim"
        }
      ]
    },
    "fallback": {
      "fala": "Não consegui abrir o diálogo da Lia.",
      "opcoes": [
        {
          "texto": "Fechar",
          "acao": "fim"
        }
      ]
    }
  }
}

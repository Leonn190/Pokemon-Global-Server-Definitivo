{
  "inicio": "saudacao",
  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Bem-vindo. Sou Marina. Minha loja parece tranquila, mas quem entende correnteza acha passagem melhor.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Você voltou para a margem certa. Quer a loja clara, a conversa da correnteza ou o caminho escondido?"
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Abrir a loja.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Falar sobre a correnteza.",
          "destino": "conversa_correnteza"
        },
        {
          "texto": "Procurar loja secreta.",
          "destino": "pergunta_secreta"
        },
        {
          "texto": "Perguntar sobre presente.",
          "destino": "checar_presente"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "loja_padrao": {
      "fala": "Pode olhar. Esses itens ficam na superfície, sem truque.",
      "saida": "loja",
      "opcoes": [
        {
          "texto": "Fechar conversa.",
          "acao": "fim"
        }
      ]
    },
    "conversa_correnteza": {
      "fala": "Vendedor bom não empurra cliente: deixa a água mostrar onde pesa menos. Você costuma seguir placa ou reparar no fluxo?",
      "ao_entrar": {
        "setor": {
          "MarinaConversa": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "Eu reparo no fluxo.",
          "destino": "fluxo"
        },
        {
          "texto": "Prefiro placa e preço.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "fluxo": {
      "fala": "Então repare: o que fica no canto da banca não é esquecido. É só reservado para quem não chega fazendo onda.",
      "ao_entrar": {
        "setor": {
          "MarinaEntendeuFluxo": true
        }
      },
      "opcoes": [
        {
          "texto": "Quero ver o canto reservado.",
          "destino": "checar_loja_secreta"
        },
        {
          "texto": "Isso libera algum presente?",
          "destino": "presente_pista"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "pergunta_secreta": {
      "fala_condicional": {
        "padrao": "Loja secreta é como maré baixa: aparece só para quem esperou o momento certo.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.MarinaEntendeuFluxo",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "Você já percebeu o canto reservado. Agora posso puxar a cortina sem fazer espuma."
          }
        ]
      },
      "ao_entrar": {
        "setor": {
          "MarinaPerguntouSecreta": true
        }
      },
      "opcoes": [
        {
          "texto_condicional": {
            "padrao": "Entender a correnteza primeiro.",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "setor.MarinaEntendeuFluxo",
                    "op": "==",
                    "valor": true
                  }
                ],
                "valor": "Abrir loja secreta."
              }
            ]
          },
          "destino_condicional": {
            "padrao": "conversa_correnteza",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "setor.MarinaEntendeuFluxo",
                    "op": "==",
                    "valor": true
                  }
                ],
                "valor": "checar_loja_secreta"
              }
            ]
          }
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "checar_loja_secreta": {
      "desvio_condicional": {
        "padrao": "loja_secreta_bloqueada",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.MarinaEntendeuFluxo",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.MarinaConversa",
                "op": ">=",
                "valor": 1
              }
            ],
            "valor": "loja_secreta"
          }
        ]
      },
      "opcoes": []
    },
    "loja_secreta_bloqueada": {
      "fala": "Calma. Você ainda está batendo na superfície. Fale comigo sobre a correnteza primeiro.",
      "opcoes": [
        {
          "texto": "Conversar.",
          "destino": "conversa_correnteza"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "loja_secreta": {
      "fala": "Pronto. A maré baixou. Olhe o que eu guardo longe do barulho.",
      "saida": "loja_secreta",
      "opcoes": [
        {
          "texto": "Fechar.",
          "acao": "fim"
        }
      ]
    },
    "presente_pista": {
      "fala": "Talvez. Eu gosto de presentear quem escuta antes de pedir. Diga que entendeu o fluxo sem pressa.",
      "ao_entrar": {
        "setor": {
          "MarinaPistaPresente": true
        }
      },
      "opcoes": [
        {
          "texto": "Eu entendi o fluxo.",
          "destino": "checar_presente"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "checar_presente": {
      "desvio_condicional": {
        "padrao": "presente_negado",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.MarinaEntendeuFluxo",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.MarinaPistaPresente",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "presente_liberado"
          }
        ]
      },
      "opcoes": []
    },
    "presente_negado": {
      "fala": "Ainda não. Presente meu não boia na primeira pergunta. Siga a correnteza da conversa.",
      "opcoes": [
        {
          "texto": "Conversar sobre isso.",
          "destino": "conversa_correnteza"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "presente_liberado": {
      "fala": "Aí sim. Você não tentou atravessar contra a água. Leve isto.",
      "saida": "presente_1",
      "opcoes": [
        {
          "texto": "Obrigado.",
          "acao": "fim"
        }
      ]
    },
    "fallback": {
      "fala": "Não consegui abrir o diálogo da Marina.",
      "opcoes": [
        {
          "texto": "Fechar",
          "acao": "fim"
        }
      ]
    }
  }
}
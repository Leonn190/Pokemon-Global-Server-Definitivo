{
  "inicio": "saudacao",
  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Michel. Negociação limpa, palavra medida e moeda no tempo certo. A loja comum está pronta; o acordo discreto exige postura.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Bem-vindo de volta. Cliente que retorna já entendeu metade da negociação. A outra metade é saber quando não insistir."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Abrir a loja.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Conversar sobre negociação.",
          "destino": "conversa_acordo"
        },
        {
          "texto": "Pedir acordo discreto.",
          "destino": "pergunta_acordo"
        },
        {
          "texto": "Tem presente?",
          "destino": "sem_presente"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "loja_padrao": {
      "fala": "Loja comum aberta. Aqui o contrato é simples: oferta, preço e escolha.",
      "saida": "loja",
      "opcoes": [
        {
          "texto": "Fechar conversa.",
          "acao": "fim"
        }
      ]
    },
    "conversa_acordo": {
      "fala": "Um bom acordo tem margem, silêncio e saída. Se falta qualquer um dos três, vira confusão com recibo bonito.",
      "ao_entrar": {
        "setor": {
          "MichelConversa": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "Fale sobre margem.",
          "destino": "margem"
        },
        {
          "texto": "Fale sobre silêncio.",
          "destino": "silencio"
        },
        {
          "texto": "Prefiro comprar.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "margem": {
      "fala": "Margem é o espaço entre o que mostro e o que posso mostrar. Quem entende isso não pede desconto gritando.",
      "ao_entrar": {
        "setor": {
          "MichelSabeMargem": true
        }
      },
      "opcoes": [
        {
          "texto": "Agora quero entender o silêncio.",
          "destino": "silencio"
        },
        {
          "texto": "Pedir acordo discreto.",
          "destino": "pergunta_acordo"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "silencio": {
      "fala": "Silêncio é não transformar estoque reservado em fofoca. Se eu abrir, você vê, escolhe e não faz teatro.",
      "ao_entrar": {
        "setor": {
          "MichelSabeSilencio": true
        }
      },
      "opcoes": [
        {
          "texto": "Aceito a regra.",
          "destino": "aceite_acordo"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "aceite_acordo": {
      "fala": "Então temos postura mínima. Não é amizade, é contrato verbal. Serve bem para negócios discretos.",
      "ao_entrar": {
        "setor": {
          "MichelAceitouContrato": true
        }
      },
      "opcoes": [
        {
          "texto": "Abrir loja secreta.",
          "destino": "checar_loja_secreta"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "pergunta_acordo": {
      "fala_condicional": {
        "padrao": "Pedido anotado, mas ainda fraco. Acordo discreto exige margem e silêncio antes de acesso.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.MichelAceitouContrato",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "Você aceitou margem e silêncio. Agora o acordo discreto pode sair do papel."
          }
        ]
      },
      "ao_entrar": {
        "setor": {
          "MichelPerguntouAcordo": true
        }
      },
      "opcoes": [
        {
          "texto_condicional": {
            "padrao": "Entender margem e silêncio.",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "setor.MichelAceitouContrato",
                    "op": "==",
                    "valor": true
                  }
                ],
                "valor": "Abrir acordo discreto."
              }
            ]
          },
          "destino_condicional": {
            "padrao": "conversa_acordo",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "setor.MichelAceitouContrato",
                    "op": "==",
                    "valor": true
                  }
                ],
                "valor": "checar_loja_secreta"
              }
            ]
          }
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "checar_loja_secreta": {
      "desvio_condicional": {
        "padrao": "loja_secreta_bloqueada",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.MichelSabeMargem",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.MichelSabeSilencio",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.MichelAceitouContrato",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "loja_secreta"
          }
        ]
      },
      "opcoes": []
    },
    "loja_secreta_bloqueada": {
      "fala": "Contrato incompleto. Falta margem, silêncio ou aceite. Sem os três, nada reservado abre.",
      "opcoes": [
        {
          "texto": "Conversar sobre negociação.",
          "destino": "conversa_acordo"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "loja_secreta": {
      "fala": "Acordo fechado. Estoque reservado aberto, sem plateia e sem discurso.",
      "saida": "loja_secreta",
      "opcoes": [
        {
          "texto": "Fechar.",
          "acao": "fim"
        }
      ]
    },
    "sem_presente": {
      "fala": "Não trabalho com presente hoje. Negócio bom já é gentileza quando ninguém sai perdendo.",
      "opcoes": [
        {
          "texto": "Então quero negociar melhor.",
          "destino": "conversa_acordo"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "fallback": {
      "fala": "Não consegui abrir o diálogo do Michel.",
      "opcoes": [
        {
          "texto": "Fechar",
          "acao": "fim"
        }
      ]
    }
  }
}

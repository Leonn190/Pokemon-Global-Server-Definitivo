{
  "inicio": "saudacao",
  "nos": {
    "saudacao": {
      "fala_condicional": {
        "padrao": "Ravena ajeita luvas escuras e aponta para a vitrine comum. Comprar e simples. Enxergar alem, nem tanto.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Outra visita. Talvez voce esteja aprendendo que a sombra aqui tem ordem."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Abrir a loja.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Conversar sobre a sombra da loja.",
          "destino": "sombra_intro"
        },
        {
          "texto": "Pedir estoque secreto.",
          "destino": "checar_loja_secreta"
        },
        {
          "texto": "Ir embora.",
          "acao": "fim"
        }
      ]
    },
    "loja_padrao": {
      "fala": "A vitrine comum nao morde. Pode olhar.",
      "saida": "loja",
      "opcoes": [
        {
          "texto": "Fechar conversa.",
          "acao": "fim"
        }
      ]
    },
    "sombra_intro": {
      "fala": "A sombra da loja tem quatro cantos. Quem entra pelo canto errado volta para o balcao.",
      "ao_entrar": {
        "setor": {
          "Ravena.EntrouNaSombra": true
        }
      },
      "opcoes": [
        {
          "texto": "Canto frio.",
          "destino": "canto_frio"
        },
        {
          "texto": "Canto gasto.",
          "destino": "canto_gasto"
        },
        {
          "texto": "Canto novo.",
          "destino": "canto_novo"
        },
        {
          "texto": "Canto brilhante.",
          "destino": "canto_brilhante"
        }
      ]
    },
    "canto_frio": {
      "fala": "Frio conserva, mas tambem endurece. Nao e por aqui.",
      "opcoes": [
        {
          "texto": "Voltar aos quatro cantos.",
          "destino": "sombra_intro"
        },
        {
          "texto": "Abrir loja comum.",
          "destino": "loja_padrao"
        }
      ]
    },
    "canto_novo": {
      "fala": "Novo demais. Segredo antigo nao gosta de cheiro de embalagem.",
      "opcoes": [
        {
          "texto": "Voltar aos quatro cantos.",
          "destino": "sombra_intro"
        },
        {
          "texto": "Tentar canto gasto.",
          "destino": "canto_gasto"
        }
      ]
    },
    "canto_brilhante": {
      "fala": "Brilhante demais. Quem quer esconder produto nao acende placa.",
      "opcoes": [
        {
          "texto": "Voltar aos quatro cantos.",
          "destino": "sombra_intro"
        },
        {
          "texto": "Tentar canto gasto.",
          "destino": "canto_gasto"
        }
      ]
    },

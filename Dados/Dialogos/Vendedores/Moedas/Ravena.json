        {
          "texto": "Olhar o risco quase apagado.",
          "destino": "risco_apagado"
        },
        {
          "texto": "Voltar.",
          "destino": "marcas_chao"
        }
      ]
    },
    "risco_torto": {
      "fala": "Torto chama curiosos. Curioso demais nao entra.",
      "opcoes": [
        {
          "texto": "Olhar o risco quase apagado.",
          "destino": "risco_apagado"
        },
        {
          "texto": "Voltar.",
          "destino": "marcas_chao"
        }
      ]

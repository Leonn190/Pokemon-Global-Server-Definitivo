        "setor": {
          "Ravena.RiscoApagado": true
        }
      },
      "opcoes": [
        {
          "texto": "Esperar Ravena falar.",
          "destino": "espera"
        },
        {
          "texto": "Bater na parede.",
          "destino": "parede_errada"
        },
        {
          "texto": "Pedir a chave.",
          "destino": "chave_cedo"
        }
      ]
    },
    "parede_errada": {
      "fala": "Parede que abre com batida nao dura uma semana numa feira.",
      "opcoes": [
        {
          "texto": "Esperar em silencio.",
          "destino": "espera"
        },
        {
          "texto": "Voltar.",
          "destino": "sombra_intro"
        }
      ]
    },
    "chave_cedo": {
      "fala": "Chave pedida cedo demais vira chave nenhuma.",

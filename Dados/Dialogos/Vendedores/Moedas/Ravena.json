    "loja_secreta_bloqueada": {
      "fala": "Nao. No meu nivel, caminho incompleto parece atalho, e atalho parece erro.",
      "opcoes": [
        {
          "texto": "Entrar de novo na sombra.",
          "destino": "sombra_intro"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }

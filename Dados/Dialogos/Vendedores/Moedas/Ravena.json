        {
          "texto": "Esperar em silencio.",
          "destino": "espera"
        },
        {
          "texto": "Voltar.",
          "destino": "sombra_intro"
        }
      ]
    },
    "espera": {
      "fala": "Ravena deixa o silencio pesar. Depois diz: 'segunda sombra, terceira prateleira, sem tocar na primeira caixa'.",
      "ao_entrar": {
        "setor": {
          "Ravena.Esperou": true
        }
      },
      "opcoes": [
        {
          "texto": "Segunda sombra.",
          "destino": "segunda_sombra"
        },
        {
          "texto": "Primeira caixa.",
          "destino": "primeira_caixa"
        },
        {
          "texto": "Terceira prateleira direto.",
          "destino": "terceira_cedo"
        }
      ]
    },
    "primeira_caixa": {
      "fala": "Eu disse sem tocar. A caixa range e a sombra fecha.",
      "opcoes": [
        {
          "texto": "Recomecar pela espera.",
          "destino": "espera"
        },
        {
          "texto": "Voltar.",
          "destino": "sombra_intro"
        }
      ]
    },
    "terceira_cedo": {
      "fala": "Prateleira sem sombra e so madeira.",
      "opcoes": [
        {
          "texto": "Ir pela segunda sombra.",
          "destino": "segunda_sombra"
        },
        {
          "texto": "Voltar.",
          "destino": "sombra_intro"
        }
      ]
    },
    "segunda_sombra": {
      "fala": "A segunda sombra mostra a terceira prateleira sem denunciar a caixa. Agora o caminho existe.",
      "ao_entrar": {
        "setor": {
          "Ravena.SegundaSombra": true
        }
      },
      "opcoes": [
        {
          "texto": "Abrir estoque reservado.",
          "destino": "checar_loja_secreta"
        },
        {
          "texto": "Voltar ao balcao.",
          "destino": "saudacao"
        }
      ]

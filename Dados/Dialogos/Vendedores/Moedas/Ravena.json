        "setor": {
          "Ravena.MarcasChao": true
        }
      },
      "opcoes": [
        {
          "texto": "Escolher o risco vertical.",
          "destino": "risco_vertical"
        },
        {
          "texto": "Escolher o risco torto.",
          "destino": "risco_torto"
        },
        {
          "texto": "Escolher o risco quase apagado.",
          "destino": "risco_apagado"
        }
      ]

        {
          "texto": "Escolher a silenciosa.",
          "destino": "moeda_silenciosa"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "moeda_silenciosa": {
      "fala": "A moeda silenciosa vale menos para venda e mais para senha. Agora pergunte sem dizer 'secreto'.",

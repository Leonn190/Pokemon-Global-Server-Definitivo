              {
                "alvo": "setor.Selena.FraseCorreta",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "Voce ja sabe o nome certo: o que fica atras do comum."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Fazer o caminho do ritmo.",
          "destino": "conversa"
        },
        {
          "texto": "Tentar abrir agora.",
          "destino": "checar_loja_secreta"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "checar_loja_secreta": {
      "desvio_condicional": {
        "padrao": "loja_secreta_bloqueada",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.Selena.PanoDobrado",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.Selena.ContouTroco",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.Selena.MoedaSilenciosa",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.Selena.FraseCorreta",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "loja_secreta"
          }
        ]
      },
      "opcoes": []
    },
    "loja_secreta_bloqueada": {
      "fala": "Nao ainda. Voce pulou algum passo: observar, contar, escolher a moeda certa e perguntar baixo.",
      "opcoes": [
        {
          "texto": "Refazer o caminho.",
          "destino": "conversa"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]

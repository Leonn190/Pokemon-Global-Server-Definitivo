        "setor": {
          "Selena.MoedaSilenciosa": true
        }
      },
      "opcoes": [
        {
          "texto": "O que fica atras do comum?",
          "destino": "frase_correta"
        },
        {
          "texto": "Mostra a loja secreta.",
          "destino": "frase_errada"
        },
        {
          "texto": "Abrir loja normal.",
          "destino": "loja_padrao"
        }
      ]
    },
    "frase_errada": {
      "fala": "Direto demais. Quem fala 'secreta' no meio da feira assusta ate o produto.",
      "opcoes": [
        {
          "texto": "Perguntar de outro jeito.",
          "destino": "moeda_silenciosa"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "frase_correta": {
      "fala": "Atras do comum fica o que nao cabe no primeiro preco. Agora sim voce falou baixo o bastante.",
      "ao_entrar": {
        "setor": {
          "Selena.FraseCorreta": true
        }
      },
      "opcoes": [
        {
          "texto": "Abrir o estoque reservado.",
          "destino": "checar_loja_secreta"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "estoque_secreto_intro": {
      "fala_condicional": {

    "loja_secreta": {
      "fala": "Silencio comprado, estoque aberto. Veja rapido; segredo parado vira fofoca.",
      "saida": "loja_secreta",
      "opcoes": [
        {
          "texto": "Fechar.",
          "acao": "fim"
        }
      ]
    },
    "fallback": {
      "fala": "Nao consegui abrir o dialogo da Selena.",
      "opcoes": [
        {
          "texto": "Fechar",
          "acao": "fim"
        }
      ]
    },
    "pergunta_errada": {
      "fala": "Perguntar antes de observar bagunca o ritmo. Selena aponta de volta para os panos.",
      "opcoes": [
        {
          "texto": "Observar primeiro.",
          "destino": "observacao"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "silencio_cedo": {
      "fala": "Silencio cedo demais vira pose. Primeiro observe o que precisa ser calado.",
      "opcoes": [
        {
          "texto": "Observar.",
          "destino": "observacao"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    }

        "setor": {
          "Selena.ContouTroco": true
        }
      },
      "opcoes": [
        {
          "texto": "Escolher a moeda barulhenta.",
          "destino": "moeda_barulho"
        },
        {
          "texto": "Escolher a moeda silenciosa.",
          "destino": "moeda_silenciosa"
        },
        {
          "texto": "Desistir.",
          "destino": "saudacao"
        }
      ]
    },
    "moeda_barulho": {
      "fala": "Barulho chama atencao. Atencao fecha porta.",

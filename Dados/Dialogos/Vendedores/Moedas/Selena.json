          {
            "condicoes": [
              {
                "alvo": "npc.visitas_anteriores",
                "op": ">",
                "valor": 0
              }
            ],
            "valor": "Voce voltou. Talvez agora escolha melhor as palavras."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Abrir a loja.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Conversar.",
          "destino": "conversa"
        },
        {
          "texto": "Perguntar sobre estoque secreto.",
          "destino": "estoque_secreto_intro"
        },
        {
          "texto": "Sair.",
          "acao": "fim"
        }
      ]
    },
    "loja_padrao": {
      "fala": "O comum fica na frente porque nao precisa se esconder.",
      "saida": "loja",
      "opcoes": [
        {
          "texto": "Fechar conversa.",
          "acao": "fim"
        }
      ]
    },
    "conversa": {
      "fala": "Negocio bom tem ritmo: primeiro voce observa, depois pergunta, depois cala.",
      "ao_entrar": {
        "setor": {
          "Selena.ObservouRitmo": true
        }
      },
      "opcoes": [
        {
          "texto": "Observar.",
          "destino": "observacao"
        },
        {
          "texto": "Perguntar.",
          "destino": "pergunta_errada"
        },
        {
          "texto": "Calar.",
          "destino": "silencio_cedo"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "observacao": {
      "fala": "Voce percebe tres panos no balcao: o claro, o escuro e o dobrado. So um deles cobre algo util.",
      "ao_entrar": {
        "setor": {
          "Selena.ObservouPanos": true
        }
      },
      "opcoes": [
        {
          "texto": "Levantar o pano claro.",
          "destino": "pano_claro"
        },
        {
          "texto": "Levantar o pano escuro.",
          "destino": "pano_escuro"
        },
        {
          "texto": "Notar o pano dobrado.",
          "destino": "pano_dobrado"
        }
      ]
    },
    "pano_claro": {
      "fala": "O claro e vitrine. Serve para chamar comprador apressado.",
      "opcoes": [
        {
          "texto": "Olhar o dobrado.",
          "destino": "pano_dobrado"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "pano_escuro": {
      "fala": "O escuro e teatro. Quem procura misterio demais acaba comprando sombra.",
      "opcoes": [
        {
          "texto": "Olhar o dobrado.",
          "destino": "pano_dobrado"
        },
        {
          "texto": "Voltar.",
          "destino": "conversa"
        }
      ]
    },
    "pano_dobrado": {
      "fala": "O dobrado nao cobre produto. Cobre uma anotacao: 'pergunte so depois de contar o troco'.",
      "ao_entrar": {
        "setor": {
          "Selena.PanoDobrado": true
        }

        "setor": {
          "VanessaConversa": {
            "op": "add",
            "valor": 1
          }
        }
      },
      "opcoes": [
        {
          "texto": "Consigo. Vou ouvir primeiro.",
          "destino": "ouvir_primeiro"
        },
        {
          "texto": "Prefiro comprar logo.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "ouvir_primeiro": {
      "fala": "Então ouça: a loja escondida não é prêmio. É filtro. Quem pede como se fosse direito perde a chance.",
      "ao_entrar": {
        "setor": {
          "VanessaEntendeuFiltro": true
        }
      },
      "opcoes": [
        {
          "texto": "Quero pedir do jeito certo.",
          "destino": "pedido_certo"
        },
        {
          "texto": "Abrir loja comum.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "pedido_certo": {
      "fala": "Peça sem se achar dono do balcão. Algo como: 'se for possível, posso ver o reservado?'. Simples, mas raro.",

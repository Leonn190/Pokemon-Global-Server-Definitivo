    "checar_loja_secreta": {
      "desvio_condicional": {
        "padrao": "loja_secreta_bloqueada",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.VanessaEntendeuFiltro",
                "op": "==",
                "valor": true
              },
              {
                "alvo": "setor.VanessaSabeFrase",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "loja_secreta"
          }
        ]
      },
      "opcoes": []
    },
    "loja_secreta_bloqueada": {
      "fala": "Não. Ainda parece curiosidade apressada. Converse, ouça, e só depois peça o reservado.",
      "opcoes": [
        {
          "texto": "Conversar.",
          "destino": "conversa_calma"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "loja_secreta": {
      "fala": "Melhor. Você pediu como visitante, não como dono. Vou abrir o reservado.",
      "saida": "loja_secreta",
      "opcoes": [
        {
          "texto": "Fechar.",
          "acao": "fim"
        }
      ]
    },
    "sem_presente": {
      "fala": "Hoje não. Eu não dou presente só para suavizar negociação. O extra aqui é acesso, não mimo.",
      "opcoes": [
        {
          "texto": "Então quero entender o acesso.",
          "destino": "conversa_calma"
        },
        {
          "texto": "Voltar.",
          "destino": "saudacao"
        }
      ]
    },
    "fallback": {
      "fala": "Não consegui abrir o diálogo da Vanessa.",
      "opcoes": [
        {
          "texto": "Fechar",
          "acao": "fim"
        }
      ]
    }

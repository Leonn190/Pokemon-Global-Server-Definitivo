            "valor": "Você voltou. Bom. Talvez agora a conversa ande melhor que da primeira vez."
          }
        ]
      },
      "opcoes": [
        {
          "texto": "Abrir a loja.",
          "destino": "loja_padrao"
        },
        {
          "texto": "Conversar com calma.",
          "destino": "conversa_calma"
        },
        {
          "texto": "Perguntar sobre loja secreta.",
          "destino": "pergunta_secreta"
        },
        {
          "texto": "Você dá presentes?",
          "destino": "sem_presente"

    "pergunta_secreta": {
      "fala_condicional": {
        "padrao": "Pergunta direta demais. Eu disse: segredo não gosta de cotovelo no balcão.",
        "casos": [
          {
            "condicoes": [
              {
                "alvo": "setor.VanessaSabeFrase",
                "op": "==",
                "valor": true
              }
            ],
            "valor": "Agora você sabe pedir sem fazer posse do segredo. Isso muda minha resposta."
          }
        ]
      },
      "ao_entrar": {
        "setor": {
          "VanessaPerguntouSecreta": true
        }
      },
      "opcoes": [
        {
          "texto_condicional": {
            "padrao": "Conversar e aprender o jeito certo.",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "setor.VanessaSabeFrase",
                    "op": "==",
                    "valor": true
                  }
                ],
                "valor": "Pedir o reservado direito."
              }
            ]
          },
          "destino_condicional": {
            "padrao": "conversa_calma",
            "casos": [
              {
                "condicoes": [
                  {
                    "alvo": "setor.VanessaSabeFrase",
                    "op": "==",
                    "valor": true
                  }
                ],
                "valor": "checar_loja_secreta"
              }
            ]
          }
        },
        {
          "texto": "Tudo bem, voltar.",
          "destino": "saudacao"
        }
      ]

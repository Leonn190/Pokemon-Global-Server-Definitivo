    "rede": {
      "fala": "Ajuda muito. Liderança não é só mandar Pokémon atacar. É saber quem está chegando, quem está crescendo, quem está perdido e quem só quer aparecer.",
      "opcoes": [
        {
          "texto": "Você observa mais do que parece.",
          "destino": "maturidade"
        },
        {
          "texto": "Isso parece administração social.",
          "destino": "lideranca"
        },
        {
          "texto": "Voltar.",
          "destino": "contatos"
        }
      ]
    },
    "vantagem": {
      "fala": "Vantagem todo mundo busca. A diferença é que eu faço isso conversando, não fingindo que sou monge isolado. Informação também é recurso.",
      "opcoes": [
        {
          "texto": "Isso parece meio perigoso.",
          "destino": "risco"
        },
        {
          "texto": "Faz sentido.",
          "destino": "simpatia"

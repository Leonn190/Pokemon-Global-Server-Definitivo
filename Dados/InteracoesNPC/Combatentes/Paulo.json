        "setor": {
          "EntendeuCulpaGuedesPaulo": true
        }
      },
      "opcoes": [
        {
          "texto": "Isso foi honesto.",
          "destino": "maturidade"
        },
        {
          "texto": "Você já falou isso para ele?",
          "destino": "amizade_guedes"
        },
        {
          "texto": "Voltar.",
          "destino": "guedes"
        }
      ]
    },
    "amizade_guedes": {
      "fala": "Sou. Amigo não some só porque alguém de fora decidiu apontar dedo. Se ele quiser mudar, eu apoio. Se quiser continuar sendo ele, eu também converso.",
      "opcoes": [
        {

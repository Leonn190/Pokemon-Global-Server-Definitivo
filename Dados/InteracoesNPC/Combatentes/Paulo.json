        {
          "texto": "Voltar.",
          "destino": "estrategia_veneno"
        }
      ]
    },
    "imunidade": {
      "fala": "Eu brinco que sou imune, mas não sou invencível. O que eu tenho é resistência, costume e leitura. Pokémon venenoso bom não depende de ser intocável, depende de saber até onde pode ir.",
      "opcoes": [
        {
          "texto": "Isso é bem mais sensato.",
          "destino": "maturidade"
        },
        {
          "texto": "Você devia falar isso para seus críticos.",
          "destino": "criticos"

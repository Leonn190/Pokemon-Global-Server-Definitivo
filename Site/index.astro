---
/*
  Este é um exemplo didático da MESMA tela em formato Astro.

  Para manter seu pedido de “arquivos soltos”, deixei este arquivo na raiz da pasta Site.
  Porém, em um projeto Astro real, normalmente ele ficaria em:

  Site/src/pages/index.astro

  A ideia aqui é você entender a diferença:
  - HTML puro: valores escritos direto no arquivo.
  - Astro: variáveis podem ficar no topo entre os ---.
*/

const nomeJogo = "Pokémon Global Server";
const subtitulo = "Um mundo online de exploração, criaturas, batalhas estratégicas e uma wiki feita para crescer junto com o jogo.";
const pastaIcones = "../Recursos/Visual/Icones/GlobalServer";

const cardsWiki = [
  {
    emoji: "⚔️",
    titulo: "Ataques",
    texto: "Fichas para dano, custo de energia, tipo, estilo, efeitos e descrição.",
  },
  {
    emoji: "🌍",
    titulo: "Mundo",
    texto: "Biomas, chunks, exploração, mapa, vilas, rotas e sistemas globais.",
  },
  {
    emoji: "✨",
    titulo: "Efeitos",
    texto: "Status positivos e negativos, duração, ícones e regras de funcionamento.",
  },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{nomeJogo}</title>
    <link rel="icon" href={`${pastaIcones}/Icone.png`} />
    <link rel="stylesheet" href="./style.css" />
    <script src="./script.js" defer></script>
  </head>

  <body>
    <div class="fundo-luz"></div>

    <header class="topbar">
      <a class="marca" href="./index.html" aria-label="Página inicial">
        <img src={`${pastaIcones}/Icone.png`} alt={`Ícone ${nomeJogo}`} />
        <span>PGS</span>
      </a>

      <nav class="menu">
        <a href="#inicio">Início</a>
        <a href="#wiki">Wiki</a>
        <a href="#novidades">Novidades</a>
        <a class="botao-menu" href="#download">Download</a>
      </nav>
    </header>

    <main id="inicio" class="pagina">
      <section class="hero">
        <div class="hero-texto">
          <p class="selo">Beta em desenvolvimento</p>
          <h1>{nomeJogo}</h1>
          <p class="subtitulo">{subtitulo}</p>

          <div class="acoes">
            <a class="botao principal" href="#wiki">Abrir wiki</a>
            <a class="botao secundario" href="#download">Ver acesso beta</a>
          </div>

          <div class="status-site" data-status-site>
            Site inicial carregado. Imagens vindas da pasta Recursos.
          </div>
        </div>

        <div class="hero-logo">
          <div class="moldura-logo">
            <img data-logo-principal src={`${pastaIcones}/Logo.png`} alt={`Logo ${nomeJogo}`} />
          </div>

          <div class="troca-logo" aria-label="Escolher visual da logo">
            <button type="button" data-logo="Logo.png" class="ativo">Logo</button>
            <button type="button" data-logo="QuadroLogo.png">Quadro</button>
            <button type="button" data-logo="Icone.png">Ícone</button>
          </div>
        </div>
      </section>

      <section id="wiki" class="secao">
        <div class="cabecalho-secao">
          <p class="selo">Wiki planejada</p>
          <h2>Base para organizar o conhecimento do jogo</h2>
        </div>

        <div class="cards">
          {cardsWiki.map((card) => (
            <article class="card">
              <span class="emoji">{card.emoji}</span>
              <h3>{card.titulo}</h3>
              <p>{card.texto}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="novidades" class="secao grade-dupla">
        <div class="painel destaque">
          <p class="selo">Astro</p>
          <h2>Este arquivo mostra a versão com variáveis</h2>
          <p>
            Repare que o título, subtítulo, caminho das imagens e cards estão declarados no topo entre os ---.
          </p>
        </div>

        <div id="download" class="painel">
          <p class="selo">Acesso</p>
          <h2>Beta fechado</h2>
          <p>
            Espaço reservado para chave de acesso, download do launcher, instruções de instalação e avisos do servidor.
          </p>
          <button class="botao principal" type="button" data-botao-alerta>Testar JS</button>
        </div>
      </section>
    </main>
  </body>
</html>

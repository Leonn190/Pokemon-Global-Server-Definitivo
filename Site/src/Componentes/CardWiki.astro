---
import { rotaSite } from "../Codigo/RotasSite.js";
const {
  href = "/wiki",
  emoji = "✨",
  titulo = "Categoria",
  texto = "Informações da seção.",
} = Astro.props;
---
<a class="card card-link" href={rotaSite(href)}>
  <span class="emoji" aria-hidden="true">{emoji}</span>
  <h3>{titulo}</h3>
  <p>{texto}</p>
</a>

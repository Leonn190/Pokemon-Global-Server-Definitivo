---
import TipoIcone from "./TipoIcone.astro";
import { normalizarChave } from "../Codigo/PokemonWikiDados.js";
const {
  itens = [],
  icones = {},
  dataAttr = "data-type-chip",
  class: classe = "",
  rotulo = "Filtros por tipo.",
  ariaPressed = false,
  ignorarChaves = [],
} = Astro.props;
const ignorados = new Set((Array.isArray(ignorarChaves) ? ignorarChaves : [ignorarChaves]).map(normalizarChave).filter(Boolean));
const visiveis = itens
  .map((item) => (typeof item === "string" ? { nome: item } : item))
  .filter((item) => item?.nome || item?.rotulo)
  .map((item) => {
    const nome = String(item.nome ?? item.rotulo ?? "").trim();
    const chave = normalizarChave(item.chave ?? nome);
    return { nome, chave, icone: item.icone ?? icones[chave] };
  })
  .filter((item) => item.chave && !ignorados.has(item.chave));
---
<section class:list={["filtros-rapidos", "filtros-tipos-icones", classe]} aria-label={rotulo}>
  {visiveis.map((item) => (
    <TipoIcone
      tipo={item.nome}
      chave={item.chave}
      icone={item.icone}
      ativo={ariaPressed ? false : undefined}
      {...{ [dataAttr]: item.chave }}
    />
  ))}
</section>

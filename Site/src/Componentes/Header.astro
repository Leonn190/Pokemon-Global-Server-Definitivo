---
import { urlPublica } from "../Codigo/AssetsPublicos.js";
import { caminhoSite, rotaSite } from "../Codigo/RotasSite.js";

const rotaAtual = caminhoSite(Astro.url.pathname);
const icone = urlPublica("GlobalServer/Icone.png");
const links = [
  { href: "/", texto: "Início" },
  { href: "/conta", texto: "Conta" },
  { href: "/contato", texto: "Contato" },
  { href: "/wiki", texto: "Wiki" },
  { href: "/download", texto: "Download", destaque: true },
];
function ativo(href) {
  if (href === "/") return rotaAtual === "/";
  return rotaAtual === href || rotaAtual.startsWith(`${href}/`);
}
---
<header class="topbar" data-topbar>
  <a class="marca" href={rotaSite("/")} aria-label="Página inicial do Pokémon Global Server">
    <img src={icone} alt="Ícone Pokémon Global Server" />
    <span>Pokémon Global Server</span>
  </a>
  <button class="menu-mobile" type="button" data-menu-mobile aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav id="menu-principal" class="menu" data-menu>
    {links.map((link) => (
      <a
        href={rotaSite(link.href)}
        class:list={[{ ativo: ativo(link.href), "botao-menu": link.destaque }]}
      >
        {link.texto}
      </a>
    ))}
  </nav>
</header>

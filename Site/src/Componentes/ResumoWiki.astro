---
const { itens = [], class: classe = "", baseClass = "pokedex-resumo", ...atributos } = Astro.props;
---
<div class:list={[baseClass, classe]} {...atributos}>
  {itens.map((item) => (
    <article>
      <strong>{item.valor}</strong>
      <span>{item.rotulo}</span>
    </article>
  ))}
  <slot />
</div>

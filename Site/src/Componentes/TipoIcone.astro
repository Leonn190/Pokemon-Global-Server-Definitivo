---
const { tipo = "", chave = "", icone = "", ativo = undefined, ...atributos } = Astro.props;
const estadoPressionado = ativo === undefined ? undefined : (ativo ? "true" : "false");
---
<button
  class:list={["tipo-chip", "tipo-chip-icone", { ativo: Boolean(ativo) }]}
  type="button"
  title={tipo}
  aria-label={`Filtrar por ${tipo}`}
  aria-pressed={estadoPressionado}
  {...atributos}
>
  <span class="tipo-icone-mini">
    {icone ? <img src={icone} alt="" loading="eager" decoding="async" /> : null}
  </span>
</button>

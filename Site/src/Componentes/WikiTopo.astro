---
import WikiMenu from "./WikiMenu.astro";
const { ativo = "", titulo = "Wiki", tituloId = "titulo-wiki", heroClasse = "wiki-hero-pokedex" } = Astro.props;
---
<section class={`wiki-hero ${heroClasse}`} aria-labelledby={tituloId}>
  <h1 id={tituloId}>{titulo}</h1>
</section>
<section class="pokedex-topo wiki-topo-simples" aria-label="Navegação da wiki">
  <WikiMenu ativo={ativo} />
</section>

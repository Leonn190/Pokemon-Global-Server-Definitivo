---
import Layout from "../Componentes/Layout.astro";
---

<Layout titulo="Conta | Pokémon Global Server" descricao="Área provisória de conta do Pokémon Global Server.">
  <section class="secao">
    <div class="cabecalho-secao">
      <p class="selo">Conta</p>
      <h1>Área da conta</h1>
      <p class="texto-fraco">
        Placeholder para login, cadastro, chave beta, recuperação de acesso e vínculo com o jogo.
      </p>
    </div>

    <div class="grade-dupla">
      <div class="painel destaque">
        <h2>Futuro cadastro</h2>
        <p>
          Aqui pode entrar a criação de conta, confirmação por e-mail e uso de chave para liberar acesso ao beta.
        </p>
      </div>

      <div class="painel">
        <h2>Chave beta</h2>
        <p>
          Espaço reservado para resgatar chave, mostrar status da conta e liberar download quando estiver pronto.
        </p>
        <button class="botao principal" type="button" data-alerta="Placeholder da área de conta.">
          Testar ação
        </button>
      </div>
    </div>
  </section>
</Layout>

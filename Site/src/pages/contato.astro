---
import Layout from "../Componentes/Layout.astro";
import "../Estilos/auth.css";
---
<Layout titulo="Contato | Pokémon Global Server" descricao="Entre em contato com o Pokémon Global Server para token, bugs, ajuda ou outros assuntos.">
  <section class="secao contato-hero contato-generico" data-contact-page>
    <div class="painel painel-contato">
      <form class="form-conta" data-contact-form>
        <div>
          <p class="selo selo-azul">Contato oficial</p>
          <h1>Fale com o projeto</h1>
          <p class="texto-fraco">
            Envie uma mensagem para a equipe do Pokémon Global Server. Escolha o motivo, preencha seus dados e acompanhe o retorno pelo Gmail informado.
          </p>
        </div>
        <label>
          <span>Seu Gmail</span>
          <input type="email" name="email" placeholder="seugmail@gmail.com" autocomplete="email" required />
        </label>
        <label>
          <span>Nome ou apelido</span>
          <input type="text" name="nome" placeholder="Como podemos te identificar?" autocomplete="name" />
        </label>
        <label>
          <span>Motivo do contato</span>
          <select name="motivo" required>
            <option value="Obter Token">Obter Token</option>
            <option value="Reportar Bug">Reportar Bug</option>
            <option value="Ajuda">Ajuda</option>
            <option value="Jogo">Jogo</option>
            <option value="Outros">Outros</option>
          </select>
        </label>
        <label>
          <span>Mensagem</span>
          <textarea name="mensagem" rows="5" placeholder="Escreva seu recado para o projeto."></textarea>
        </label>
        <button class="botao principal" type="submit">Enviar contato</button>
        <p class="mensagem-form" data-contact-message aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

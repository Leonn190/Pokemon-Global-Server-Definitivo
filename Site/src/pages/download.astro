---
import Layout from "../Componentes/Layout.astro";
import Botao from "../Componentes/Botao.astro";
import "../Estilos/auth.css";
---
<Layout titulo="Download | Pokémon Global Server" descricao="Download e requisitos do Pokémon Global Server.">
  <section class="secao download-hero" data-download-page>
    <aside class="painel download-gate" aria-live="polite">
      <div class="gate-icone">🔒</div>
      <p class="selo selo-azul">Download protegido</p>
      <h1>Acesso bloqueado</h1>
      <p>
        O download é liberado para treinadores com conta ativa e token autorizado. Entre na sua conta ou crie seu acesso para continuar.
      </p>
      <div class="acoes">
        <Botao href="/conta">Entrar</Botao>
        <Botao href="/conta" tipo="secundario">Criar conta</Botao>
        <Botao href="/contato" tipo="fantasma">Pedir token</Botao>
      </div>
    </aside>
  </section>

  <section class="secao requisitos" aria-labelledby="titulo-requisitos">
    <div class="cabecalho-secao compacto-auth">
      <p class="selo">Requisitos</p>
      <h2 id="titulo-requisitos">Preparado para rodar leve, com margem para o mundo crescer</h2>
      <p class="texto-fraco">Use estas configurações como base para jogar com estabilidade durante o beta.</p>
    </div>
    <div class="grade-requisitos">
      <article class="painel requisito-card minimo">
        <span class="tag-requisito">Mínimo</span>
        <h3>Para abrir e testar</h3>
        <ul class="lista-requisitos">
          <li><strong>Sistema:</strong> Windows 10 64 bits</li>
          <li><strong>Memória RAM:</strong> 2 GB</li>
          <li><strong>Processador:</strong> Dual-core 2.0 GHz, Intel Core i3 4ª geração ou AMD A6 equivalente</li>
          <li><strong>Placa de vídeo:</strong> Intel HD 4000, Radeon R5, GeForce GT 710 ou equivalente com suporte a OpenGL 3.3</li>
          <li><strong>Armazenamento:</strong> 2 GB livres</li>
          <li><strong>Internet:</strong> conexão estável para acesso online</li>
          <li><strong>Tela:</strong> 1366 x 768 ou superior</li>
        </ul>
      </article>
      <article class="painel requisito-card recomendado">
        <span class="tag-requisito">Recomendado</span>
        <h3>Para jogar com folga</h3>
        <ul class="lista-requisitos">
          <li><strong>Sistema:</strong> Windows 10/11 64 bits</li>
          <li><strong>Memória RAM:</strong> 4 GB ou mais</li>
          <li><strong>Processador:</strong> Quad-core, Intel Core i5 6ª geração, Ryzen 3 ou melhor</li>
          <li><strong>Placa de vídeo:</strong> GTX 750, Radeon RX 550, Intel UHD/Iris Xe ou melhor com OpenGL 3.3+</li>
          <li><strong>Armazenamento:</strong> 4 GB livres para jogo, cache e atualizações</li>
          <li><strong>Internet:</strong> banda larga estável</li>
          <li><strong>Tela:</strong> 1920 x 1080 recomendado</li>
        </ul>
      </article>
    </div>
  </section>
</Layout>

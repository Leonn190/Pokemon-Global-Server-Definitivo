---
import Layout from "../Componentes/Layout.astro";
import Botao from "../Componentes/Botao.astro";
import { indexarPublicoPorNome, urlPublica } from "../Codigo/AssetsPublicos.js";
import {
  ATRIBUTOS_BASE,
  carregarPokemons,
  criarAssetsPokemons,
  normalizarChave,
  selecionarDestaquesHome,
} from "../Codigo/PokemonWikiDados.js";
import "../Estilos/wiki.css";
import "../Estilos/home.css";
const pokemonsHome = carregarPokemons();
const totalPokemonsHome = pokemonsHome.length || 1307;
const estatisticas = [
  { valor: String(totalPokemonsHome), rotulo: "Pokémon cadastrados" },
  { valor: "183", rotulo: "Ataques cadastrados" },
  { valor: "50", rotulo: "Efeitos e status" },
  { valor: "145", rotulo: "Itens registrados" },
  { valor: "64", rotulo: "Equipáveis" },
];
const logo = urlPublica("GlobalServer/Logo.webp");
const quadroLogo = urlPublica("GlobalServer/QuadroLogo.webp");
const imagensPokemonsHomeIndexadas = indexarPublicoPorNome("Imagens");
const iconesTiposHome = indexarPublicoPorNome("Tipos");
const iconesAtributosHome = indexarPublicoPorNome("Atributos");
const destaquesHome = selecionarDestaquesHome(pokemonsHome, 44, imagensPokemonsHomeIndexadas);
const trilhoDestaquesHome = [...destaquesHome, ...destaquesHome];
const assetsDestaquesHome = criarAssetsPokemons(destaquesHome, imagensPokemonsHomeIndexadas);
const classeChanceHome = (chance) => {
  const valor = Number(chance);
  if (!Number.isFinite(valor)) return "chance-neutra";
  if (valor > 50) return "chance-ouro";
  if (valor === 50) return "chance-prata";
  return "chance-bronze";
};
const ehRadianteHome = (pokemon) => normalizarChave(pokemon?.nome).includes("radiante");
const nomeHome = (pokemon) => String(pokemon.nome || pokemon.nomeExibicao || "Pokémon").replace(/\s+/g, " ").trim();
const payloadHomePokemon = JSON.stringify({
  pokemons: destaquesHome,
  assetsPokemons: assetsDestaquesHome,
  iconesTipos: iconesTiposHome,
  iconesAtributos: iconesAtributosHome,
  atributosBase: ATRIBUTOS_BASE,
}).replace(/</g, "\\u003c");
---
<Layout
  titulo="Início | Pokémon Global Server"
  descricao="Página inicial do Pokémon Global Server, um RPG online 2D de exploração, captura, craft e batalhas estratégicas."
>
  <section class="hero-home" aria-labelledby="titulo-principal">
    <div class="hero-aurora" aria-hidden="true"></div>
    <div class="logo-palco" aria-label="Logo Pokémon Global Server">
      <div class="anel-luz anel-luz-azul"></div>
      <div class="anel-luz anel-luz-vermelho"></div>
      <div class="orbita orbita-um"></div>
      <div class="orbita orbita-dois"></div>
      <img class="logo-principal" src={logo} alt="Logo Pokémon Global Server" />
    </div>
    <div class="hero-copy">
      <p class="selo">Fan game online 2D em desenvolvimento</p>
      <h1 id="titulo-principal">Pokémon Global Server</h1>
      <p class="subtitulo-home">
        Entre em um mundo online 2D feito para explorar, capturar, evoluir equipes, coletar recursos, criar itens e vencer batalhas com estratégia de verdade.
      </p>
      <div class="acoes hero-acoes">
        <Botao href="/wiki">Explorar a wiki</Botao>
        <Botao href="/download" tipo="secundario">Ver acesso beta</Botao>
      </div>
    </div>
  </section>
  <section class="secao secao-conteudo" aria-labelledby="titulo-visao">
    <div class="intro-home">
      <figure class="quadro-logo-card">
        <img src={quadroLogo} alt="Arte promocional do Pokémon Global Server com iluminação azul e vermelha" />
        <figcaption>Exploração 2D com clima de mundo grande, servidor e batalha estratégica.</figcaption>
      </figure>
      <div class="intro-copy">
        <p class="selo">Visão do jogo</p>
        <h2 id="titulo-visao">Explore. Capture. Batalhe.</h2>
        <p>
          Pokémon Global Server é um fan game 2D onde o jogador sai pelo mapa, descobre biomas, captura criaturas, coleta recursos, monta equipe, cria itens e entra em batalhas que dependem de energia, efeitos, tipos e posicionamento.
        </p>
        <div class="mini-destaques" aria-label="Destaques da experiência">
          <article>
            <strong>Mundo por chunks</strong>
            <span>Mapa enorme sem carregar tudo de uma vez.</span>
          </article>
          <article>
            <strong>Arena tática</strong>
            <span>Ações planejadas, logs e animações no cliente.</span>
          </article>
          <article>
            <strong>Progressão completa</strong>
            <span>Captura, evolução, inventário, craft e equipamentos.</span>
          </article>
        </div>
      </div>
    </div>
    <div class="estatisticas-home" aria-label="Estatísticas do projeto">
      {estatisticas.map((item) => (
        <article class="estatistica-card">
          <strong>{item.valor}</strong>
          <span>{item.rotulo}</span>
        </article>
      ))}
    </div>
  </section>
  <section class="secao pokemon-destaque-home pokemon-destaque-carrossel-home" data-home-pokemon-carousel aria-labelledby="titulo-pokemon-destaque">
    <div class="pokemon-destaque-copy">
      <h2 id="titulo-pokemon-destaque">Explore um catálogo diversificado</h2>
    </div>
    <div class="pokemon-carrossel-janela" aria-label="Pokémons em destaque em carrossel">
      <div class="pokemon-carrossel-trilho">
        {trilhoDestaquesHome.map((pokemon) => {
          const asset = assetsDestaquesHome[pokemon.id];
          const radiante = ehRadianteHome(pokemon);
          return (
            <button class={`pokemon-card pokemon-card-home ${radiante ? "pokemon-radiante" : ""}`} type="button" data-home-pokemon-id={pokemon.id}>
              <span class="pokemon-card-codigo">#{pokemon.id}</span>
              <span class="pokemon-card-arte">
                {asset?.imagem ? (
                  <img class={radiante ? "sprite-radiante" : ""} src={asset.imagem} alt={nomeHome(pokemon)} loading="lazy" decoding="async" />
                ) : (
                  <span class="pokemon-card-sem-arte">{nomeHome(pokemon).slice(0, 1)}</span>
                )}
              </span>
              <span class="pokemon-card-nome">{nomeHome(pokemon)}</span>
              <span class="pokemon-card-meta">{pokemon.grupo}</span>
              <span class="pokemon-card-tipos">
                {pokemon.tipos.map((tipo) => {
                  const icone = iconesTiposHome[normalizarChave(tipo.nome)];
                  return (
                    <span class={`tipo-bola pequena ${classeChanceHome(tipo.chance)}`} title={`${tipo.nome}${tipo.chance ? ` ${tipo.chance}%` : ""}`}>
                      {icone ? <img src={icone} alt={tipo.nome} loading="eager" decoding="async" /> : <b>{tipo.nome.slice(0, 1)}</b>}
                    </span>
                  );
                })}
              </span>
              <span class="pokemon-card-poder"><strong>{pokemon.total}</strong><small>Poder total</small></span>
            </button>
          );
        })}
      </div>
    </div>
    <div class="acoes pokemon-carrossel-acoes">
      <Botao href="/wiki" tipo="fantasma">Ver wiki completa</Botao>
      <Botao href="/wiki/pokemons">Abrir Pokédex</Botao>
    </div>
  </section>

  <section class="secao instalar-home" aria-labelledby="titulo-instalar">
    <div class="instalar-card">
      <p class="selo selo-azul">Como instalar</p>
      <h2 id="titulo-instalar">Acesso beta com token</h2>
      <p>
        O jogo ainda está em fase beta. Para instalar, primeiro crie uma conta do Pokémon Global Server. O acesso ainda é exclusivo para quem possui token; você pode pedir um token entrando em contato com o projeto.
      </p>
      <div class="acoes instalar-acoes">
        <Botao href="/contato">Pedir token</Botao>
        <Botao href="/conta" tipo="secundario">Criar conta</Botao>
        <Botao href="/download" tipo="fantasma">Fazer download</Botao>
      </div>
    </div>
  </section>
  <aside class="pokemon-detalhe" data-home-pokemon-detail hidden aria-live="polite">
    <div class="pokemon-detalhe-backdrop" data-pokemon-close></div>
    <article class="pokemon-detalhe-card" role="dialog" aria-modal="true" aria-labelledby="pokemon-home-detalhe-nome">
      <div class="pokemon-controles-detalhe" aria-label="Navegação do Pokémon aberto">
        <button class="pokemon-navegar" type="button" data-pokemon-prev aria-label="Pokémon anterior">‹</button>
        <button class="pokemon-navegar" type="button" data-pokemon-next aria-label="Próximo Pokémon">›</button>
        <button class="pokemon-fechar" type="button" data-pokemon-close aria-label="Fechar detalhes">×</button>
      </div>
      <div class="pokemon-detalhe-topo">
        <div class="pokemon-palco-detalhe">
          <div class="pokemon-brilho-detalhe"></div>
          <img data-detail-image alt="" loading="lazy" decoding="async" />
          <div class="pokemon-sem-imagem" data-detail-fallback hidden></div>
        </div>
        <div class="pokemon-cabecalho-detalhe">
          <span class="codigo-pokemon" data-detail-code>#000</span>
          <h2 id="pokemon-home-detalhe-nome" data-detail-name>Pokémon</h2>
          <div class="pokemon-tags" data-detail-tags></div>
          <p data-detail-summary hidden></p>
        </div>
      </div>
      <div class="pokemon-detalhe-grid">
        <section class="painel-detalhe">
          <h3>Atributos básicos</h3>
          <div class="barras-atributos" data-detail-stats></div>
        </section>
        <section class="painel-detalhe">
          <h3>Informações</h3>
          <dl class="pokemon-info-lista" data-detail-info></dl>
        </section>
      </div>
      <section class="painel-detalhe painel-linhagem" data-detail-line-panel hidden>
        <div class="painel-titulo-linha">
          <h3>Linhagem / evoluções</h3>
          <span data-detail-line-count></span>
        </div>
        <div class="linhagem-lista" data-detail-line></div>
      </section>
    </article>
  </aside>
  <section class="aviso-legal">
    <strong>Projeto independente e educacional.</strong>
    <p>
      Este projeto é feito para estudo e portfólio, sem finalidade comercial. Não é afiliado, patrocinado, aprovado ou associado à Nintendo, The Pokémon Company, Creatures Inc. ou GAME FREAK inc. Pokémon e marcas relacionadas pertencem aos seus respectivos proprietários.
    </p>
  </section>
  <script id="pokemon-home-data" type="application/json" set:html={payloadHomePokemon}></script>
  <script>
    import { inicializarCarrosselHome } from "../Codigo/PokedexRuntime.js";
    inicializarCarrosselHome();
  </script>
</Layout>

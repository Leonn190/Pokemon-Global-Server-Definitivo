---
import Layout from "../Componentes/Layout.astro";
import Botao from "../Componentes/Botao.astro";
import logo from "@recursos/Visual/Icones/GlobalServer/Logo.png";
import quadroLogo from "@recursos/Visual/Icones/GlobalServer/QuadroLogo.png";
import {
  carregarPokemons,
  criarAssetsPokemons,
  indexarArquivosPorNome,
  selecionarDestaquesHome,
} from "../Codigo/PokemonWikiDados.js";
import "../Estilos/home.css";

const pokemonsHome = carregarPokemons();
const totalPokemonsHome = pokemonsHome.length || 1307;

const estatisticas = [
  { valor: String(totalPokemonsHome), rotulo: "Pokémon cadastrados" },
  { valor: "75", rotulo: "Ataques cadastrados" },
  { valor: "50", rotulo: "Efeitos e status" },
  { valor: "142", rotulo: "Itens registrados" },
  { valor: "63", rotulo: "Equipáveis" },
  { valor: "20", rotulo: "Tipos no sistema" },
];

const pilares = [
  {
    etiqueta: "Exploração",
    titulo: "Mundo aberto vivo",
    texto:
      "Um mapa procedural de 10.000 x 10.000 blocos, dividido em chunks, com biomas, estruturas, vilas, baús, NPCs, rotas e pontos de interesse para descobrir.",
  },
  {
    etiqueta: "Combate",
    titulo: "Arena tática com decisão real",
    texto:
      "O combate sai do automático: ações planejadas, energia, atributos, efeitos, clima, tipos, posicionamento, logs e animações dos acontecimentos no cliente.",
  },
  {
    etiqueta: "Progressão",
    titulo: "Loot, captura, craft e evolução",
    texto:
      "O jogador explora, encontra criaturas, coleta recursos, captura Pokémon, evolui a equipe, usa equipamentos e transforma materiais em itens úteis.",
  },
  {
    etiqueta: "Arquitetura",
    titulo: "Servidor cuidando das regras",
    texto:
      "Por trás da tela, o cliente mostra o jogo e o servidor simulado segura a lógica: mundo, spawns, inventário, batalhas, validações e persistência.",
  },
];

const tecnologias = [
  "Python e Pygame",
  "Pipeline 2D próprio",
  "Integração inicial com ModernGL",
  "Dados em CSV, JSON e TOML",
  "Servidor com tick de mundo",
  "Mapa explorável com cache por chunks",
];

const destaquesHome = selecionarDestaquesHome(pokemonsHome, 8);
const imagensPokemonsHome = import.meta.glob("@recursos/Visual/Pokemons/Imagens/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP,gif,GIF}", {
  eager: true,
  query: "?url",
  import: "default",
});
const assetsDestaquesHome = criarAssetsPokemons(destaquesHome, indexarArquivosPorNome(imagensPokemonsHome));
const primeiroDestaque = destaquesHome[0] ?? null;
---

<Layout
  titulo="Início | Pokémon Global Server"
  descricao="Página inicial do Pokémon Global Server, um RPG online 2D de exploração, captura, craft e batalhas estratégicas."
>
  <section class="hero-home" aria-labelledby="titulo-principal">
    <div class="hero-aurora" aria-hidden="true"></div>

    <div class="logo-palco" aria-label="Logo Pokémon Global Server">
      <div class="anel-luz anel-luz-azul"></div>
      <div class="anel-luz anel-luz-vermelho"></div>
      <div class="orbita orbita-um"></div>
      <div class="orbita orbita-dois"></div>
      <img class="logo-principal" src={logo.src} alt="Logo Pokémon Global Server" />
    </div>

    <div class="hero-copy">
      <p class="selo">Fan game online 2D em desenvolvimento</p>
      <h1 id="titulo-principal">Pokémon Global Server</h1>
      <p class="subtitulo-home">
        Entre em um mundo online 2D feito para explorar, capturar, evoluir equipes, coletar recursos, criar itens e vencer batalhas com estratégia de verdade.
      </p>

      <div class="acoes hero-acoes">
        <Botao href="/wiki">Explorar a wiki</Botao>
        <Botao href="/download" tipo="secundario">Ver acesso beta</Botao>
      </div>
    </div>
  </section>

  <section class="secao secao-conteudo" aria-labelledby="titulo-visao">
    <div class="intro-home">
      <figure class="quadro-logo-card">
        <img src={quadroLogo.src} alt="Arte promocional do Pokémon Global Server com iluminação azul e vermelha" />
        <figcaption>Exploração 2D com clima de mundo grande, servidor e batalha estratégica.</figcaption>
      </figure>

      <div class="intro-copy">
        <p class="selo">Visão do jogo</p>
        <h2 id="titulo-visao">Explore. Capture. Batalhe.</h2>
        <p>
          Pokémon Global Server é um fan game 2D onde o jogador sai pelo mapa, descobre biomas, captura criaturas, coleta recursos, monta equipe, cria itens e entra em batalhas que dependem de energia, efeitos, tipos e posicionamento.
        </p>

        <div class="mini-destaques" aria-label="Destaques da experiência">
          <article>
            <strong>Mundo por chunks</strong>
            <span>Mapa enorme sem carregar tudo de uma vez.</span>
          </article>
          <article>
            <strong>Arena tática</strong>
            <span>Ações planejadas, logs e animações no cliente.</span>
          </article>
          <article>
            <strong>Progressão completa</strong>
            <span>Captura, evolução, inventário, craft e equipamentos.</span>
          </article>
        </div>
      </div>
    </div>

    <div class="estatisticas-home" aria-label="Estatísticas do projeto">
      {estatisticas.map((item) => (
        <article class="estatistica-card">
          <strong>{item.valor}</strong>
          <span>{item.rotulo}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="secao pokemon-destaque-home" data-home-pokemon-spotlight aria-labelledby="titulo-pokemon-destaque">
    <div class="pokemon-destaque-copy">
      <p class="selo">Pokémon em destaque</p>
      <h2 id="titulo-pokemon-destaque">A wiki também vive na página inicial</h2>
      <p>
        Um destaque rotativo mostra criaturas registradas no CSV, seus tipos, grupo, raridade, poder total e atributos principais. É uma prévia direta da Pokédex Global.
      </p>
      <div class="acoes">
        <Botao href="/wiki/pokemons">Abrir Pokédex</Botao>
        <Botao href="/wiki" tipo="fantasma">Ver wiki completa</Botao>
      </div>
    </div>

    <article class="pokemon-destaque-card">
      <div class="pokemon-destaque-arte">
        <div class="pokemon-destaque-aura"></div>
        {primeiroDestaque && assetsDestaquesHome[primeiroDestaque.id]?.imagem ? (
          <img data-home-pokemon-image src={assetsDestaquesHome[primeiroDestaque.id].imagem} alt={primeiroDestaque.nome} loading="lazy" />
        ) : (
          <span data-home-pokemon-fallback>{primeiroDestaque?.nome?.slice(0, 1) ?? "?"}</span>
        )}
      </div>

      <div class="pokemon-destaque-info">
        <span class="codigo-pokemon" data-home-pokemon-code>{primeiroDestaque ? `#${primeiroDestaque.id}` : "#000"}</span>
        <h3 data-home-pokemon-name>{primeiroDestaque?.nome ?? "Pokémon"}</h3>
        <div class="pokemon-destaque-tipos" data-home-pokemon-types>
          {primeiroDestaque?.tipos.map((tipo) => <span>{tipo.nome} {tipo.chance ? `${tipo.chance}%` : ""}</span>)}
        </div>

        <div class="pokemon-destaque-metricas">
          <article><strong data-home-pokemon-total>{primeiroDestaque?.total ?? "-"}</strong><span>Poder total</span></article>
          <article><strong data-home-pokemon-group>{primeiroDestaque?.grupo ?? "-"}</strong><span>Grupo</span></article>
          <article><strong data-home-pokemon-rarity>{primeiroDestaque?.raridadeTexto ?? "-"}</strong><span>Raridade</span></article>
        </div>

        <div class="pokemon-destaque-barras" data-home-pokemon-bars></div>
      </div>
    </article>
  </section>

  <section class="secao grade-pilares" aria-label="Principais sistemas do jogo">
    {pilares.map((pilar) => (
      <article class="pilar-card">
        <span>{pilar.etiqueta}</span>
        <h2>{pilar.titulo}</h2>
        <p>{pilar.texto}</p>
      </article>
    ))}
  </section>

  <section class="secao destaque-tecnico" aria-labelledby="titulo-tecnico">
    <div class="painel-tecnico">
      <p class="selo">Por trás do jogo</p>
      <h2 id="titulo-tecnico">Não é só uma tela bonita: tem sistema segurando tudo</h2>
      <p>
        O projeto separa cliente, servidor simulado, dados, regras, cenas, HUD, mapa, batalha e persistência. A base foi pensada para crescer sem virar um amontoado de código hardcoded.
      </p>

      <div class="chips-tecnicos">
        {tecnologias.map((tecnologia) => <span>{tecnologia}</span>)}
      </div>
    </div>

    <div class="painel-lateral">
      <h3>O que deixa o projeto mais ambicioso</h3>
      <ul class="lista-destaques">
        <li>Mundo carregado por chunks, sem tentar enfiar o mapa inteiro na tela.</li>
        <li>Mapa explorável com áreas ocultas, cache e descoberta progressiva.</li>
        <li>Ataques, itens, efeitos, receitas e regras fora do código duro, em tabelas e arquivos de configuração.</li>
        <li>Combate resolvido pelo servidor e reproduzido no cliente com logs e animações.</li>
      </ul>
    </div>
  </section>

  <section class="secao jornada-home" aria-labelledby="titulo-jornada">
    <div class="cabecalho-home compacto">
      <p class="selo">Loop do jogo</p>
      <h2 id="titulo-jornada">Explorar, crescer e entrar na arena</h2>
    </div>

    <div class="trilha-jogo">
      <article>
        <strong>01</strong>
        <h3>Explorar</h3>
        <p>O jogador cruza biomas, abre o mapa aos poucos, encontra NPCs, baús, estruturas e áreas especiais.</p>
      </article>
      <article>
        <strong>02</strong>
        <h3>Coletar e evoluir</h3>
        <p>Capturas, recursos, itens, equipamentos e receitas fazem a equipe ficar cada vez mais forte.</p>
      </article>
      <article>
        <strong>03</strong>
        <h3>Planejar ações</h3>
        <p>Antes da rodada, o jogador escolhe ataques, movimentos, trocas, alvos e como gastar energia.</p>
      </article>
      <article>
        <strong>04</strong>
        <h3>Assistir aos logs</h3>
        <p>O servidor resolve tudo e o cliente transforma os resultados em animações, efeitos e HUD.</p>
      </article>
    </div>
  </section>

  <section class="aviso-legal">
    <strong>Projeto independente e educacional.</strong>
    <p>
      Este projeto é feito para estudo e portfólio, sem finalidade comercial. Não é afiliado, patrocinado, aprovado ou associado à Nintendo, The Pokémon Company, Creatures Inc. ou GAME FREAK inc. Pokémon e marcas relacionadas pertencem aos seus respectivos proprietários.
    </p>
  </section>
  <script define:vars={{ destaquesHome, assetsDestaquesHome }}>
    const spotlight = document.querySelector("[data-home-pokemon-spotlight]");

    if (spotlight && destaquesHome.length) {
      const imagem = spotlight.querySelector("[data-home-pokemon-image]");
      const fallback = spotlight.querySelector("[data-home-pokemon-fallback]");
      const codigo = spotlight.querySelector("[data-home-pokemon-code]");
      const nome = spotlight.querySelector("[data-home-pokemon-name]");
      const tipos = spotlight.querySelector("[data-home-pokemon-types]");
      const total = spotlight.querySelector("[data-home-pokemon-total]");
      const grupo = spotlight.querySelector("[data-home-pokemon-group]");
      const raridade = spotlight.querySelector("[data-home-pokemon-rarity]");
      const barras = spotlight.querySelector("[data-home-pokemon-bars]");
      const principais = ["Vida", "Atk", "Def", "SpA", "SpD", "Vel"];
      let atual = 0;

      const formatar = (valor) => valor === null || valor === undefined ? "-" : String(valor);
      const maximos = Object.fromEntries(principais.map((atributo) => [
        atributo,
        Math.max(1, ...destaquesHome.map((pokemon) => pokemon.atributos?.[atributo] ?? 0)),
      ]));

      function renderDestaque() {
        const pokemon = destaquesHome[atual];
        const asset = assetsDestaquesHome[pokemon.id] ?? {};
        spotlight.classList.remove("trocando");
        void spotlight.offsetWidth;
        spotlight.classList.add("trocando");

        if (codigo) codigo.textContent = `#${pokemon.id}`;
        if (nome) nome.textContent = pokemon.nome;
        if (total) total.textContent = formatar(pokemon.total);
        if (grupo) grupo.textContent = pokemon.grupo || "-";
        if (raridade) raridade.textContent = pokemon.raridadeTexto || "-";

        if (tipos) {
          tipos.innerHTML = pokemon.tipos.map((tipo) => `<span>${tipo.nome}${tipo.chance ? ` ${tipo.chance}%` : ""}</span>`).join("");
        }

        if (imagem && asset.imagem) {
          imagem.hidden = false;
          imagem.src = asset.imagem;
          imagem.alt = pokemon.nome;
          if (fallback) fallback.hidden = true;
        } else if (fallback) {
          fallback.hidden = false;
          fallback.textContent = pokemon.nome.slice(0, 1);
          if (imagem) imagem.hidden = true;
        }

        if (barras) {
          barras.innerHTML = principais.map((atributo) => {
            const valor = pokemon.atributos?.[atributo] ?? 0;
            const largura = Math.max(4, Math.min(100, (valor / maximos[atributo]) * 100));
            return `<div><span>${atributo}</span><i><b style="width:${largura}%"></b></i><strong>${valor}</strong></div>`;
          }).join("");
        }
      }

      renderDestaque();
      window.setInterval(() => {
        atual = (atual + 1) % destaquesHome.length;
        renderDestaque();
      }, 4200);
    }
  </script>
</Layout>

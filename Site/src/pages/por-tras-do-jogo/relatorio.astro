---
import Layout from "../../Componentes/Layout.astro";
import Botao from "../../Componentes/Botao.astro";
import { carregarRelatorios } from "../../Codigo/RelatoriosDados.js";
import "../../Estilos/wiki.css";
import "../../Estilos/por-tras-do-jogo.css";

const relatorios = carregarRelatorios();
const relatorioAtual = relatorios.find((relatorio) => relatorio.atual) ?? relatorios[0];
---
<Layout
  titulo="Relatórios | Pokémon Global Server"
  descricao="Relatório técnico atual do Pokémon Global Server a partir do Registro.md."
>
  <section class="por-tras-hero relatorio-hero" aria-labelledby="titulo-relatorios">
    <p class="selo">Relatórios</p>
    <h1 id="titulo-relatorios">Registro técnico do projeto</h1>
    <p>
      Esta página carrega o relatório atual da raiz do repositório, o <code>Registro.md</code>, para mostrar o andamento técnico mais recente do projeto.
    </p>
    <div class="acoes por-tras-acoes">
      <Botao href="/por-tras-do-jogo" tipo="secundario">Voltar para Por trás do jogo</Botao>
    </div>
  </section>

  <section class="secao relatorio-app" data-relatorios-app aria-labelledby="titulo-relatorio-aberto">
    <article class="relatorio-card" aria-live="polite">
      <header>
        <p class="selo selo-azul" data-relatorio-arquivo>{relatorioAtual.arquivo}</p>
        <h2 id="titulo-relatorio-aberto" data-relatorio-titulo>{relatorioAtual.titulo}</h2>
      </header>
      <div class="relatorio-conteudo" data-relatorio-conteudo set:html={relatorioAtual.html}></div>
    </article>
  </section>

</Layout>

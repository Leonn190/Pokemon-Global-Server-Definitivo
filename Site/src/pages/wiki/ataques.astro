---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiCatalogoShell from "../../Componentes/WikiCatalogoShell.astro";
import CampoBuscaWiki from "../../Componentes/CampoBuscaWiki.astro";
import SelectFiltroWiki from "../../Componentes/SelectFiltroWiki.astro";
import FiltroTipoIcones from "../../Componentes/FiltroTipoIcones.astro";
import ModalDetalhe from "../../Componentes/ModalDetalhe.astro";
import ModalControles from "../../Componentes/ModalControles.astro";
import DetalheTopo from "../../Componentes/DetalheTopo.astro";
import PainelDetalhe from "../../Componentes/PainelDetalhe.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  FOCOS_ATAQUE,
  carregarAtaques,
  criarAssetsAtaques,
  indexarIconesAtaques,
  resumoAtaques,
} from "../../Codigo/AtaquesWikiDados.js";
import { indexarPublicoPorNome, listarImagensPublicas } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const ataques = carregarAtaques();
const resumo = resumoAtaques(ataques);
const iconesAtaques = indexarIconesAtaques(listarImagensPublicas("Ataques"));
const iconesTipos = indexarPublicoPorNome("Tipos");
const assetsAtaques = criarAssetsAtaques(ataques, iconesAtaques);
const estilos = [...new Map(ataques.map((ataque) => [ataque.estiloBusca, ataque.estiloRotulo])).entries()].sort((a, b) => a[1].localeCompare(b[1], "pt-BR"));
const motores = resumo.motores;
const payloadAtaques = { ataques, assetsAtaques, iconesTipos, resumo };
const opcoesOrdenacao = [
  ["ordem", "Ordem oficial"],
  ["nome", "Alfabética"],
  ["custo", "Custo"],
  ["ofensivo", "Ofensivo"],
  ["defensivo", "Defensivo"],
  ["suporte", "Suporte"],
  ["utilitario", "Utilitário"],
].map(([value, label]) => ({ value, label }));
const opcoesEstilo = [{ value: "", label: "Todos" }, ...estilos.map(([value, label]) => ({ value, label }))];
const opcoesMotor = [{ value: "", label: "Todos" }, ...motores.map((motor) => ({ value: motor.chave, label: motor.rotulo }))];
const opcoesFoco = [{ value: "", label: "Todos" }, ...FOCOS_ATAQUE.map((foco) => ({ value: foco.chave, label: foco.rotulo }))];
---
<Layout
  titulo="Ataques"
  descricao="Wiki de ataques do Pokémon Global Server, com busca, filtros por tipo, estilo, motor, foco e detalhes de aprimoramento."
>
  <WikiTopo ativo="ataques" titulo="Ataques" tituloId="titulo-ataques" />
  <WikiCatalogoShell
    appClass="ataques-app"
    appAttrs={{ "data-ataques-app": true }}
    toolbarClass="ataques-toolbar"
    toolbarRotulo="Ferramentas da wiki de ataques"
    quantidade={resumo.quantidade}
    countAttrs={{ "data-ataques-count": true }}
    directionAttrs={{ "data-ataques-direction": true }}
    clearAttrs={{ "data-ataques-clear": true }}
    clearAriaLabel="Limpar todos os filtros de ataques"
    gridClass="itens-grid ataques-grid"
    gridAttrs={{ "data-ataques-grid": true }}
    gridRotulo="Lista de ataques"
    vazioAttrs={{ "data-ataques-empty": true }}
    vazioTitulo="Nenhum ataque encontrado."
    sentinelAttrs={{ "data-ataques-sentinel": true }}
  >
    <Fragment slot="toolbar">
      <CampoBuscaWiki data-ataques-search placeholder="Nome, código, tipo, motor ou descrição..." />
      <SelectFiltroWiki data-ataques-sort label="Ordenar" options={opcoesOrdenacao} />
      <SelectFiltroWiki data-ataques-style label="Estilo" options={opcoesEstilo} />
      <SelectFiltroWiki data-ataques-motor label="Motor" options={opcoesMotor} />
      <SelectFiltroWiki data-ataques-focus label="Foco" options={opcoesFoco} />
    </Fragment>
    <FiltroTipoIcones
      slot="after-toolbar"
      itens={resumo.tipos}
      icones={iconesTipos}
      dataAttr="data-ataques-type-chip"
      class="filtros-tipos-ataques"
      rotulo="Filtros por tipo. Selecione um tipo por vez."
      ariaPressed
    />
  </WikiCatalogoShell>
  <ModalDetalhe
    class="item-detalhe pokemon-detalhe"
    cardClass="pokemon-detalhe-card item-detalhe-card ataque-detalhe-card"
    labelledby="ataque-detalhe-nome"
    backdropAttrs={{ "data-ataque-close": true }}
    data-ataque-detail
  >
    <ModalControles
      rotulo="Navegação do ataque aberto"
      prevLabel="Ataque anterior"
      nextLabel="Próximo ataque"
      prevAttrs={{ "data-ataque-prev": true }}
      nextAttrs={{ "data-ataque-next": true }}
      closeAttrs={{ "data-ataque-close": true }}
    />
    <DetalheTopo
      class="item-detalhe-topo ataque-detalhe-topo"
      palcoClass="item-palco-detalhe ataque-palco-detalhe"
      cabecalhoClass="ataque-cabecalho-detalhe"
      imageAttrs={{ "data-ataque-image": true }}
      codeAttrs={{ "data-ataque-code": true }}
      nameAttrs={{ id: "ataque-detalhe-nome", "data-ataque-name": true }}
      nomeFallback="Ataque"
    >
      <div class="pokemon-tags" data-ataque-tags></div>
    </DetalheTopo>
    <PainelDetalhe titulo="Descrição" class="item-info-painel ataque-texto-painel">
      <p class="item-descricao-melhor" data-ataque-description></p>
    </PainelDetalhe>
    <PainelDetalhe titulo="Aprimoramento" class="item-info-painel ataque-texto-painel">
      <div class="item-descricao-melhor" data-ataque-upgrade></div>
    </PainelDetalhe>
    <section class="painel-detalhe ataque-foco-painel">
      <div data-ataque-focus-bars></div>
    </section>
  </ModalDetalhe>
  <JsonPayload id="ataques-data" dados={payloadAtaques} />
  <script>
    import { inicializarWikiAtaques } from "../../Codigo/AtaquesRuntime.js";
    inicializarWikiAtaques();
  </script>
</Layout>

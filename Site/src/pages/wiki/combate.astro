---
import Layout from "../../Componentes/Layout.astro";
import WikiMenu from "../../Componentes/WikiMenu.astro";
import "../../Estilos/wiki.css";
---

<Layout titulo="Combate | Wiki Pokémon Global Server" descricao="Área de Combate da wiki do Pokémon Global Server.">
  <section class="wiki-hero wiki-hero-pokedex" aria-labelledby="titulo-combate">
    <h1 id="titulo-combate">Combate</h1>
  </section>

  <section class="pokedex-topo" aria-label="Navegação da wiki">
    <div class="pokedex-resumo wiki-placeholder-resumo" aria-label="Resumo da área">
      <article>
        <strong>0</strong>
        <span>Registros publicados</span>
      </article>
      <article>
        <strong>0</strong>
        <span>Categorias</span>
      </article>
      <article>
        <strong>Beta</strong>
        <span>Estado da wiki</span>
      </article>
    </div>

    <WikiMenu ativo="combate" />
  </section>

  <section class="wiki-placeholder-card">
    <p class="selo">Wiki em expansão</p>
    <h2>Combate ainda vai receber dados próprios.</h2>
    <p>Regras de batalha, turnos, energia, dano, colisões, indicadores e animações.</p>
  </section>
</Layout>

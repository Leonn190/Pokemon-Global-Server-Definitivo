---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiCatalogoShell from "../../Componentes/WikiCatalogoShell.astro";
import CampoBuscaWiki from "../../Componentes/CampoBuscaWiki.astro";
import SelectFiltroWiki from "../../Componentes/SelectFiltroWiki.astro";
import ModalDetalhe from "../../Componentes/ModalDetalhe.astro";
import ModalControles from "../../Componentes/ModalControles.astro";
import DetalheTopo from "../../Componentes/DetalheTopo.astro";
import PainelDetalhe from "../../Componentes/PainelDetalhe.astro";
import PokemonDetalheModal from "../../Componentes/PokemonDetalheModal.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  DIFICULDADES_DUNGEON,
  TAMANHOS_DUNGEON,
  carregarDungeons,
  criarAssetsDungeons,
  indexarIconesDungeons,
  resumoDungeons,
} from "../../Codigo/DungeonsWikiDados.js";
import {
  ATRIBUTOS_BASE,
  carregarPokemons,
  criarAssetsPokemons,
  normalizarChave,
} from "../../Codigo/PokemonWikiDados.js";
import { indexarPublicoPorNome, listarImagensPublicas } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const dungeons = carregarDungeons();
const resumo = resumoDungeons(dungeons);
const pokemons = carregarPokemons();
const iconesDungeons = indexarIconesDungeons(listarImagensPublicas(["Medalhoes", "Medalhões", "Dungeons"]));
const assetsDungeons = criarAssetsDungeons(dungeons, iconesDungeons);
const imagensPorNome = indexarPublicoPorNome("Imagens");
const iconesTipos = indexarPublicoPorNome("Tipos");
const iconesAtributos = indexarPublicoPorNome("Atributos");
const assetsPokemons = criarAssetsPokemons(pokemons, imagensPorNome);
const payloadDungeons = { dungeons, assetsDungeons, resumo };
const payloadPokedex = { pokemons, assetsPokemons, iconesTipos, iconesAtributos, atributosBase: ATRIBUTOS_BASE };
const opcoesOrdenacao = [
  ["ordem", "Ordem oficial"],
  ["nome", "Alfabética"],
  ["dificuldade", "Dificuldade"],
  ["tamanho", "Tamanho"],
  ["bioma", "Bioma"],
].map(([value, label]) => ({ value, label }));
const opcoesDificuldade = [{ value: "", label: "Todas" }, ...Object.entries(DIFICULDADES_DUNGEON).map(([value, label]) => ({ value, label }))];
const opcoesTamanho = [{ value: "", label: "Todos" }, ...Object.entries(TAMANHOS_DUNGEON).map(([value, label]) => ({ value, label }))];
const opcoesBioma = [{ value: "", label: "Todos" }, ...resumo.biomas.map((bioma) => ({ value: normalizarChave(bioma), label: bioma }))];
---
<Layout
  titulo="Dungeons"
  descricao="Wiki de dungeons do Pokémon Global Server, com tamanho, dificuldade, biomas, entradas, bosses e servos."
>
  <WikiTopo ativo="dungeons" titulo="Dungeons" tituloId="titulo-dungeons" />
  <WikiCatalogoShell
    appClass="dungeons-app"
    appAttrs={{ "data-dungeons-app": true }}
    toolbarClass="dungeons-toolbar"
    toolbarRotulo="Ferramentas da wiki de dungeons"
    quantidade={resumo.quantidade}
    countAttrs={{ "data-dungeons-count": true }}
    directionAttrs={{ "data-dungeons-direction": true }}
    clearAttrs={{ "data-dungeons-clear": true }}
    clearAriaLabel="Limpar todos os filtros de dungeons"
    gridClass="itens-grid dungeons-grid"
    gridAttrs={{ "data-dungeons-grid": true }}
    gridRotulo="Lista de dungeons"
    vazioAttrs={{ "data-dungeons-empty": true }}
    vazioTitulo="Nenhuma dungeon encontrada."
    sentinelAttrs={{ "data-dungeons-sentinel": true }}
  >
    <Fragment slot="toolbar">
      <CampoBuscaWiki data-dungeons-search placeholder="Nome, código, bioma ou Pokémon..." />
      <SelectFiltroWiki data-dungeons-sort label="Ordenar" options={opcoesOrdenacao} />
      <SelectFiltroWiki data-dungeons-difficulty label="Dificuldade" options={opcoesDificuldade} />
      <SelectFiltroWiki data-dungeons-size label="Tamanho" options={opcoesTamanho} />
      <SelectFiltroWiki data-dungeons-biome label="Bioma" options={opcoesBioma} />
    </Fragment>
  </WikiCatalogoShell>
  <ModalDetalhe
    class="item-detalhe pokemon-detalhe"
    cardClass="pokemon-detalhe-card item-detalhe-card dungeon-detalhe-card"
    labelledby="dungeon-detalhe-nome"
    backdropAttrs={{ "data-dungeon-close": true }}
    data-dungeon-detail
  >
    <ModalControles
      rotulo="Navegação da dungeon aberta"
      prevLabel="Dungeon anterior"
      nextLabel="Próxima dungeon"
      prevAttrs={{ "data-dungeon-prev": true }}
      nextAttrs={{ "data-dungeon-next": true }}
      closeAttrs={{ "data-dungeon-close": true }}
    />
    <DetalheTopo
      class="item-detalhe-topo dungeon-detalhe-topo"
      palcoClass="item-palco-detalhe dungeon-palco-detalhe"
      cabecalhoClass="dungeon-cabecalho-detalhe"
      imageAttrs={{ "data-dungeon-image": true }}
      codeAttrs={{ "data-dungeon-code": true }}
      nameAttrs={{ id: "dungeon-detalhe-nome", "data-dungeon-name": true }}
      nomeFallback="Dungeon"
    />
    <PainelDetalhe titulo="Informações" class="item-info-painel">
      <dl class="pokemon-info-lista" data-dungeon-info></dl>
    </PainelDetalhe>
    <PainelDetalhe titulo="Pokémons envolvidos" class="item-info-painel dungeon-pokemon-painel">
      <div class="dungeon-pokemon-grid" data-dungeon-pokemons></div>
    </PainelDetalhe>
    <PainelDetalhe titulo="Pokémons servos" class="item-info-painel dungeon-pokemon-painel">
      <div class="dungeon-pokemon-grid" data-dungeon-servos></div>
    </PainelDetalhe>
  </ModalDetalhe>
  <PokemonDetalheModal
    labelledby="pokemon-dungeon-detalhe-nome"
    class="pokemon-detalhe dungeon-pokemon-detalhe"
    detailAttrs={{ "data-dungeon-pokemon-detail": true }}
  />
  <JsonPayload id="dungeons-data" dados={payloadDungeons} />
  <JsonPayload id="dungeons-pokedex-data" dados={payloadPokedex} />
  <script>
    import { inicializarWikiDungeons } from "../../Codigo/DungeonsRuntime.js";
    inicializarWikiDungeons();
  </script>
</Layout>

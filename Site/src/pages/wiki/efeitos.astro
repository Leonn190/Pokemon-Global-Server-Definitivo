---
import Layout from "../../Componentes/Layout.astro";
import "../../Estilos/wiki.css";
---

<Layout titulo="Efeitos | Wiki Pokémon Global Server" descricao="Página provisória de Efeitos da wiki.">
  <section class="wiki-hero wiki-hero-pokedex" aria-labelledby="titulo-efeitos">
    <h1 id="titulo-efeitos">Efeitos</h1>
  </section>

  <section class="pokedex-topo" aria-label="Navegação da wiki">
    <div class="pokedex-resumo wiki-placeholder-resumo" aria-label="Resumo da área">
      <article><strong>Beta</strong><span>Estado da wiki</span></article>
      <article><strong>0</strong><span>Registros publicados</span></article>
      <article><strong>0</strong><span>Categorias</span></article>
      <article><strong>0</strong><span>Filtros ativos</span></article>
    </div>

    <nav class="wiki-menu-lateral wiki-menu-topo" aria-label="Outras áreas da wiki">
      <a href="/wiki/pokemons">Pokémons</a>
      <a href="/wiki/itens">Itens</a>
      <a href="/wiki/combate">Combate</a>
      <a href="/wiki/dungeons">Dungeons</a>
      <a href="/wiki/equipaveis">Equipáveis</a>
      <a class="ativo" href="/wiki/efeitos">Efeitos</a>
      <a class="" href="/wiki/estadios">Estádios</a>
      <a class="" href="/wiki/mundo">Mundo</a>
    </nav>
  </section>

  <section class="wiki-placeholder-card">
    <p class="selo">Wiki em expansão</p>
    <h2>Efeitos</h2>
    <p>Área futura para status positivos, negativos, efeitos de terreno, buffs, debuffs e ícones.</p>
  </section>
</Layout>

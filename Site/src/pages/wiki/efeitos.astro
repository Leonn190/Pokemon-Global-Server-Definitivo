---
import Layout from "../../Componentes/Layout.astro";
import "../../Estilos/wiki.css";
---

<Layout titulo="Efeitos | Wiki PGS" descricao="Página provisória de Efeitos da wiki.">
  <section class="wiki-hero">
    <p class="selo">Wiki / Efeitos</p>
    <h1>Efeitos</h1>
    <p class="wiki-descricao">
      Página futura para status positivos, negativos, efeitos de terreno, buffs, debuffs e ícones.
    </p>
  </section>

  <section class="wiki-layout">
    <aside class="wiki-menu-lateral">
      <a href="/wiki/pokemons">Pokémons</a>
      <a href="/wiki/itens">Itens</a>
      <a class="ativo" href="/wiki/efeitos">Efeitos</a>
      <a href="/wiki/estadios">Estádios</a>
      <a href="/wiki/mundo">Mundo</a>
    </aside>

    <div class="wiki-conteudo">
      <div class="wiki-grid">
        <article class="bloco-info">
          <h2>Status</h2>
          <p>Espaço para explicar efeitos como Queimado, Envenenado, Congelado, Imune, Furtivo e outros.</p>
          <div class="placeholder-lista">
            <div class="placeholder-item"><strong>Positivos</strong><span>buffs e proteções</span></div>
            <div class="placeholder-item"><strong>Negativos</strong><span>dano, controle, redução</span></div>
            <div class="placeholder-item"><strong>Terreno</strong><span>efeitos de tiles</span></div>
          </div>
        </article>

        <article class="bloco-info">
          <h2>Ícones</h2>
          <p>Depois dá para montar uma grade com os ícones que você está criando para cada efeito.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>

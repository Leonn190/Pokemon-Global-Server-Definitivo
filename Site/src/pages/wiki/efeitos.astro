---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiCatalogoShell from "../../Componentes/WikiCatalogoShell.astro";
import CampoBuscaWiki from "../../Componentes/CampoBuscaWiki.astro";
import SelectFiltroWiki from "../../Componentes/SelectFiltroWiki.astro";
import ModalDetalhe from "../../Componentes/ModalDetalhe.astro";
import ModalControles from "../../Componentes/ModalControles.astro";
import DetalheTopo from "../../Componentes/DetalheTopo.astro";
import PainelDetalhe from "../../Componentes/PainelDetalhe.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  OPCOES_ESTILO_EFEITO,
  OPCOES_SENTIDO_EFEITO,
  carregarEfeitos,
  criarAssetsEfeitos,
  indexarIconesEfeitos,
  resumoEfeitos,
} from "../../Codigo/EfeitosWikiDados.js";
import { listarImagensPublicas } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const efeitos = carregarEfeitos();
const resumo = resumoEfeitos(efeitos);
const iconesEfeitos = indexarIconesEfeitos(listarImagensPublicas("Efeitos"));
const assetsEfeitos = criarAssetsEfeitos(efeitos, iconesEfeitos);
const payloadEfeitos = { efeitos, assetsEfeitos, resumo };
const opcoesOrdenacao = [{ value: "ordem", label: "Ordem oficial" }, { value: "nome", label: "Alfabética" }];
const opcoesEstilo = [{ value: "", label: "Todos" }, ...Object.entries(OPCOES_ESTILO_EFEITO).map(([value, label]) => ({ value, label }))];
const opcoesSentido = [{ value: "", label: "Todos" }, ...Object.entries(OPCOES_SENTIDO_EFEITO).map(([value, label]) => ({ value, label }))];
---
<Layout
  titulo="Efeitos"
  descricao="Wiki de efeitos do Pokémon Global Server, com status de Pokémon, climas, terrenos, filtros e descrições."
>
  <WikiTopo ativo="efeitos" titulo="Efeitos" tituloId="titulo-efeitos" />
  <WikiCatalogoShell
    appClass="efeitos-app"
    appAttrs={{ "data-efeitos-app": true }}
    toolbarClass="efeitos-toolbar"
    toolbarRotulo="Ferramentas da wiki de efeitos"
    quantidade={efeitos.length}
    countAttrs={{ "data-efeitos-count": true }}
    directionAttrs={{ "data-efeitos-direction": true }}
    clearAttrs={{ "data-efeitos-clear": true }}
    clearAriaLabel="Limpar todos os filtros de efeitos"
    gridClass="itens-grid efeitos-grid"
    gridAttrs={{ "data-efeitos-grid": true }}
    gridRotulo="Lista de efeitos"
    vazioAttrs={{ "data-efeitos-empty": true }}
    vazioTitulo="Nenhum efeito encontrado."
    sentinelAttrs={{ "data-efeitos-sentinel": true }}
  >
    <Fragment slot="toolbar">
      <CampoBuscaWiki data-efeitos-search placeholder="Nome, código, estilo ou descrição..." />
      <SelectFiltroWiki data-efeitos-sort label="Ordenar" options={opcoesOrdenacao} />
      <SelectFiltroWiki data-efeitos-style label="Estilo" options={opcoesEstilo} />
      <SelectFiltroWiki data-efeitos-sense label="Sentido" options={opcoesSentido} />
    </Fragment>
  </WikiCatalogoShell>
  <ModalDetalhe
    class="item-detalhe pokemon-detalhe"
    cardClass="pokemon-detalhe-card item-detalhe-card efeito-detalhe-card"
    labelledby="efeito-detalhe-nome"
    backdropAttrs={{ "data-efeito-close": true }}
    data-efeito-detail
  >
    <ModalControles
      rotulo="Navegação do efeito aberto"
      prevLabel="Efeito anterior"
      nextLabel="Próximo efeito"
      prevAttrs={{ "data-efeito-prev": true }}
      nextAttrs={{ "data-efeito-next": true }}
      closeAttrs={{ "data-efeito-close": true }}
    />
    <DetalheTopo
      class="item-detalhe-topo efeito-detalhe-topo"
      palcoClass="item-palco-detalhe efeito-palco-detalhe"
      cabecalhoClass="efeito-cabecalho-detalhe"
      imageAttrs={{ "data-efeito-image": true }}
      codeAttrs={{ "data-efeito-code": true }}
      nameAttrs={{ id: "efeito-detalhe-nome", "data-efeito-name": true }}
      nomeFallback="Efeito"
    >
      <div class="pokemon-tags" data-efeito-tags></div>
      <p class="item-descricao-melhor" data-efeito-description></p>
    </DetalheTopo>
    <PainelDetalhe titulo="Informações" class="item-info-painel">
      <dl class="pokemon-info-lista" data-efeito-info></dl>
    </PainelDetalhe>
  </ModalDetalhe>
  <JsonPayload id="efeitos-data" dados={payloadEfeitos} />
  <script>
    import { inicializarWikiEfeitos } from "../../Codigo/EfeitosRuntime.js";
    inicializarWikiEfeitos();
  </script>
</Layout>

---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiCatalogoShell from "../../Componentes/WikiCatalogoShell.astro";
import CampoBuscaWiki from "../../Componentes/CampoBuscaWiki.astro";
import SelectFiltroWiki from "../../Componentes/SelectFiltroWiki.astro";
import FiltroTipoIcones from "../../Componentes/FiltroTipoIcones.astro";
import ModalDetalhe from "../../Componentes/ModalDetalhe.astro";
import ModalControles from "../../Componentes/ModalControles.astro";
import DetalheTopo from "../../Componentes/DetalheTopo.astro";
import PainelDetalhe from "../../Componentes/PainelDetalhe.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  ATRIBUTOS_EQUIPAVEIS,
  FOCOS_EQUIPAVEIS,
  carregarEquipaveis,
  criarAssetsEquipaveis,
  resumoEquipaveis,
} from "../../Codigo/EquipaveisWikiDados.js";
import { indexarPublicoPorNome } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const equipaveis = carregarEquipaveis();
const resumo = resumoEquipaveis(equipaveis);
const imagensEquipaveis = indexarPublicoPorNome(["Equipaveis", "Equipáveis", "Objetos", "Itens", "Recursos"]);
const iconesTipos = indexarPublicoPorNome("Tipos");
const iconesAtributos = indexarPublicoPorNome("Atributos");
const assetsEquipaveis = criarAssetsEquipaveis(equipaveis, imagensEquipaveis);
const payloadEquipaveis = { equipaveis, assetsEquipaveis, iconesTipos, iconesAtributos, resumo };
const opcoesOrdenacao = [
  ["ordem", "Ordem oficial"],
  ["nome", "Alfabética"],
  ["atributo", "Aumento do atributo"],
  ["ofensivo", "Ofensivo"],
  ["defensivo", "Defensivo"],
  ["suporte", "Suporte"],
  ["utilitario", "Utilitário"],
].map(([value, label]) => ({ value, label }));
const opcoesAtributo = [
  { value: "", label: "Todos" },
  ...ATRIBUTOS_EQUIPAVEIS.filter((atributo) => !["Bar", "Dur", "Amp"].includes(atributo.chave)).map((atributo) => ({ value: atributo.chave, label: atributo.rotulo })),
];
const opcoesFoco = [{ value: "", label: "Todos" }, ...FOCOS_EQUIPAVEIS.map((foco) => ({ value: foco.chave, label: foco.rotulo }))];
---
<Layout
  titulo="Equipáveis"
  descricao="Wiki de equipáveis do Pokémon Global Server, com afinidade, atributos aumentados, foco e detalhes de cada equipamento."
>
  <WikiTopo ativo="equipaveis" titulo="Equipáveis" tituloId="titulo-equipaveis" />
  <WikiCatalogoShell
    appClass="equipaveis-app"
    appAttrs={{ "data-equipaveis-app": true }}
    toolbarClass="equipaveis-toolbar"
    toolbarRotulo="Ferramentas da wiki de equipáveis"
    quantidade={resumo.quantidade}
    countAttrs={{ "data-equipaveis-count": true }}
    directionAttrs={{ "data-equipaveis-direction": true }}
    clearAttrs={{ "data-equipaveis-clear": true }}
    clearAriaLabel="Limpar todos os filtros de equipáveis"
    gridClass="itens-grid equipaveis-grid"
    gridAttrs={{ "data-equipaveis-grid": true }}
    gridRotulo="Lista de equipáveis"
    vazioAttrs={{ "data-equipaveis-empty": true }}
    vazioTitulo="Nenhum equipável encontrado."
    sentinelAttrs={{ "data-equipaveis-sentinel": true }}
  >
    <Fragment slot="toolbar">
      <CampoBuscaWiki data-equipaveis-search placeholder="Nome, código, afinidade ou descrição..." />
      <SelectFiltroWiki data-equipaveis-sort label="Ordenar" options={opcoesOrdenacao} />
      <SelectFiltroWiki data-equipaveis-attribute label="Atributo" options={opcoesAtributo} />
      <SelectFiltroWiki data-equipaveis-focus label="Foco" options={opcoesFoco} />
    </Fragment>
    <FiltroTipoIcones
      slot="after-toolbar"
      itens={resumo.afinidades}
      icones={iconesTipos}
      dataAttr="data-equipaveis-type-chip"
      class="filtros-tipos-equipaveis"
      rotulo="Filtros por afinidade. Selecione uma afinidade por vez."
      ignorarChaves={["semafinidade"]}
      ariaPressed
    />
  </WikiCatalogoShell>
  <ModalDetalhe
    class="item-detalhe pokemon-detalhe"
    cardClass="pokemon-detalhe-card item-detalhe-card equipavel-detalhe-card"
    labelledby="equipavel-detalhe-nome"
    backdropAttrs={{ "data-equipavel-close": true }}
    data-equipavel-detail
  >
    <ModalControles
      rotulo="Navegação do equipável aberto"
      prevLabel="Equipável anterior"
      nextLabel="Próximo equipável"
      prevAttrs={{ "data-equipavel-prev": true }}
      nextAttrs={{ "data-equipavel-next": true }}
      closeAttrs={{ "data-equipavel-close": true }}
    />
    <DetalheTopo
      class="item-detalhe-topo equipavel-detalhe-topo"
      palcoClass="item-palco-detalhe equipavel-palco-detalhe"
      cabecalhoClass="equipavel-cabecalho-detalhe"
      imageAttrs={{ "data-equipavel-image": true }}
      codeAttrs={{ "data-equipavel-code": true }}
      nameAttrs={{ id: "equipavel-detalhe-nome", "data-equipavel-name": true }}
      nomeFallback="Equipável"
    >
      <div class="pokemon-tags" data-equipavel-tags></div>
      <p class="item-descricao-melhor" data-equipavel-description></p>
    </DetalheTopo>
    <div class="pokemon-detalhe-grid equipavel-detalhe-grid">
      <PainelDetalhe titulo="Atributos aumentados">
        <div class="equipavel-atributos" data-equipavel-attributes></div>
      </PainelDetalhe>
      <PainelDetalhe titulo="Foco">
        <div data-equipavel-focus-bars></div>
      </PainelDetalhe>
    </div>
  </ModalDetalhe>
  <JsonPayload id="equipaveis-data" dados={payloadEquipaveis} />
  <script>
    import { inicializarWikiEquipaveis } from "../../Codigo/EquipaveisRuntime.js";
    inicializarWikiEquipaveis();
  </script>
</Layout>

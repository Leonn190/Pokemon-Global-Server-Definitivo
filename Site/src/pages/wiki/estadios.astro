---
import Layout from "../../Componentes/Layout.astro";
import WikiMenu from "../../Componentes/WikiMenu.astro";
import "../../Estilos/wiki.css";
---

<Layout titulo="Estádios | Wiki Pokémon Global Server" descricao="Área de Estádios da wiki do Pokémon Global Server.">
  <section class="wiki-hero wiki-hero-pokedex" aria-labelledby="titulo-estadios">
    <h1 id="titulo-estadios">Estádios</h1>
  </section>

  <section class="pokedex-topo" aria-label="Navegação da wiki">
    <div class="pokedex-resumo wiki-placeholder-resumo" aria-label="Resumo da área">
      <article>
        <strong>0</strong>
        <span>Registros publicados</span>
      </article>
      <article>
        <strong>0</strong>
        <span>Categorias</span>
      </article>
      <article>
        <strong>Beta</strong>
        <span>Estado da wiki</span>
      </article>
    </div>

    <WikiMenu ativo="estadios" />
  </section>

  <section class="wiki-placeholder-card">
    <p class="selo">Wiki em expansão</p>
    <h2>Estádios ainda vai receber dados próprios.</h2>
    <p>Arenas, regras de batalha, layouts, clima, tiles e modos especiais.</p>
  </section>
</Layout>

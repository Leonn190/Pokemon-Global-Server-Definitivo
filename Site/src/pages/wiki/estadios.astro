---
import Layout from "../../Componentes/Layout.astro";
import "../../Estilos/wiki.css";
---

<Layout titulo="Estádios | Wiki Pokémon Global Server" descricao="Página provisória de Estádios da wiki.">
  <section class="wiki-hero">
    <p class="selo">Wiki / Estádios</p>
    <h1>Estádios</h1>
    <p class="wiki-descricao">
      Página futura para arenas, regras de batalha, layouts, clima, tiles e modos especiais.
    </p>
  </section>

  <section class="wiki-layout">
    <aside class="wiki-menu-lateral">
      <a href="/wiki/pokemons">Pokémons</a>
      <a href="/wiki/itens">Itens</a>
      <a href="/wiki/efeitos">Efeitos</a>
      <a class="ativo" href="/wiki/estadios">Estádios</a>
      <a href="/wiki/mundo">Mundo</a>
    </aside>

    <div class="wiki-conteudo">
      <div class="wiki-grid">
        <article class="bloco-info">
          <h2>Arenas</h2>
          <p>Espaço para mapas de batalha, tamanho da arena, obstáculos, tiles e efeitos ativos.</p>
          <div class="placeholder-lista">
            <div class="placeholder-item"><strong>Estádio exemplo</strong><span>clima neutro</span></div>
            <div class="placeholder-item"><strong>Estádio exemplo</strong><span>terreno especial</span></div>
            <div class="placeholder-item"><strong>Estádio exemplo</strong><span>modo futuro</span></div>
          </div>
        </article>

        <article class="bloco-info">
          <h2>Batalha</h2>
          <p>Depois esta área pode explicar regras de turno, ticks, energia, colisões e posicionamento.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>

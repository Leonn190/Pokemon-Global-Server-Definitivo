---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiGrid from "../../Componentes/WikiGrid.astro";
import ModalDetalhe from "../../Componentes/ModalDetalhe.astro";
import ModalControles from "../../Componentes/ModalControles.astro";
import DetalheTopo from "../../Componentes/DetalheTopo.astro";
import PainelDetalhe from "../../Componentes/PainelDetalhe.astro";
import NpcDetalheModal from "../../Componentes/NpcDetalheModal.astro";
import PokemonDetalheModal from "../../Componentes/PokemonDetalheModal.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  carregarEstadios,
  carregarNpcs,
  criarAssetsEstadios,
  criarAssetsNpcs,
  indexarIconesEstadios,
  indexarSkinsNpcs,
  resumoEstadios,
} from "../../Codigo/NpcsWikiDados.js";
import {
  ATRIBUTOS_BASE,
  carregarPokemons,
  criarAssetsPokemons,
} from "../../Codigo/PokemonWikiDados.js";
import { indexarPublicoPorNome, listarImagensPublicas } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const npcs = carregarNpcs();
const estadios = carregarEstadios(npcs);
const resumo = resumoEstadios(estadios, npcs);
const pokemons = carregarPokemons();
const skinsNpcs = indexarSkinsNpcs(listarImagensPublicas("Skins"));
const assetsNpcs = criarAssetsNpcs(npcs, skinsNpcs);
const iconesEstadios = indexarIconesEstadios(listarImagensPublicas(["Insigneas", "Insignias", "Insígnias"]));
const assetsEstadios = criarAssetsEstadios(estadios, iconesEstadios);
const imagensPorNome = indexarPublicoPorNome("Imagens");
const iconesTipos = indexarPublicoPorNome("Tipos");
const iconesAtributos = indexarPublicoPorNome("Atributos");
const assetsPokemons = criarAssetsPokemons(pokemons, imagensPorNome);
const payloadEstadios = { estadios, assetsEstadios, npcs, assetsNpcs };
const payloadPokedex = { pokemons, assetsPokemons, iconesTipos, iconesAtributos, atributosBase: ATRIBUTOS_BASE };
---
<Layout
  titulo="Estádios"
  descricao="Wiki de estádios do Pokémon Global Server, com explicação da progressão e lista de membros de cada estádio."
>
  <WikiTopo ativo="estadios" titulo="Estádios" tituloId="titulo-estadios" />
  <section class="wiki-mundo-blocos estadios-intro" aria-label="Funcionamento dos estádios">
    <article class="mundo-bloco mundo-bloco-destaque">
      <span class="selo">Progressão de estádio</span>
      <h2>Estádios são centros de desafio espalhados pelo mapa.</h2>
      <p>
        O mundo possui vários estádios, com a ideia de existir um para cada tipo principal do jogo. Em cada estádio,
        o jogador enfrenta associados daquela tipagem, ganha respeito dentro da organização e avança até a última
        batalha para conquistar a insígnia.
      </p>
    </article>
    <article class="mundo-bloco">
      <h3>Associados, capitães e líderes</h3>
      <p>
        A progressão começa pelos desafiantes e associados do estádio, passa por cargos intermediários e chega ao líder.
        Depois de conquistar a insígnia, continuar batalhando no mesmo estádio pode abrir caminho para disputar espaço
        e, futuramente, se tornar o próprio líder daquele tipo.
      </p>
    </article>
  </section>
  <section class="wiki-layout wiki-layout-pokedex estadios-layout">
    <div class="wiki-conteudo pokedex-app estadios-app" data-estadios-app>
      <section class="mundo-secao-cabecalho">
        <span class="selo">Estádios conhecidos</span>
        <h2>Grid de estádios</h2>
        <p>Cada cartucho usa a insígnia do tipo e abre a lista de membros cadastrados para aquele estádio.</p>
      </section>
      <WikiGrid class="itens-grid estadios-grid" data-estadios-grid rotulo="Lista de estádios" />
    </div>
  </section>
  <ModalDetalhe
    class="item-detalhe pokemon-detalhe"
    cardClass="pokemon-detalhe-card item-detalhe-card estadio-detalhe-card"
    labelledby="estadio-detalhe-nome"
    backdropAttrs={{ "data-estadio-close": true }}
    data-estadio-detail
  >
    <ModalControles
      rotulo="Navegação do estádio aberto"
      prevLabel="Estádio anterior"
      nextLabel="Próximo estádio"
      prevAttrs={{ "data-estadio-prev": true }}
      nextAttrs={{ "data-estadio-next": true }}
      closeAttrs={{ "data-estadio-close": true }}
    />
    <DetalheTopo
      class="item-detalhe-topo estadio-detalhe-topo"
      palcoClass="item-palco-detalhe estadio-palco-detalhe"
      cabecalhoClass="estadio-cabecalho-detalhe"
      imageAttrs={{ "data-estadio-image": true }}
      codeAttrs={{ "data-estadio-code": true }}
      nameAttrs={{ id: "estadio-detalhe-nome", "data-estadio-name": true }}
      nomeFallback="Estádio"
    >
      <div class="pokemon-tags" data-estadio-tags></div>
    </DetalheTopo>
    <PainelDetalhe titulo="Membros do estádio" class="item-info-painel estadio-membros-painel">
      <div data-estadio-members></div>
    </PainelDetalhe>
  </ModalDetalhe>
  <NpcDetalheModal
    labelledby="npc-estadio-detalhe-nome"
    class="item-detalhe pokemon-detalhe estadio-npc-detalhe"
    detailAttrs={{ "data-estadio-npc-detail": true }}
  />
  <PokemonDetalheModal
    labelledby="pokemon-estadio-detalhe-nome"
    class="pokemon-detalhe dungeon-pokemon-detalhe estadio-pokemon-detalhe"
    detailAttrs={{ "data-estadio-pokemon-detail": true }}
  />
  <JsonPayload id="estadios-data" dados={payloadEstadios} />
  <JsonPayload id="estadios-pokedex-data" dados={payloadPokedex} />
  <script>
    import { inicializarWikiEstadios } from "../../Codigo/EstadiosRuntime.js";
    inicializarWikiEstadios();
  </script>
</Layout>

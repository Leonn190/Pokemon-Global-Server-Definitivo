---
import Layout from "../../Componentes/Layout.astro";
import CardWiki from "../../Componentes/CardWiki.astro";
import CampoBuscaWiki from "../../Componentes/CampoBuscaWiki.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import { SECOES_WIKI, montarIndiceBuscaWiki } from "../../Codigo/WikiBuscaGlobalDados.js";
import "../../Estilos/wiki.css";

const secoes = SECOES_WIKI;
const indiceBuscaWiki = montarIndiceBuscaWiki();
---
<Layout titulo="Wiki | Pokémon Global Server" descricao="Wiki do Pokémon Global Server.">
  <section class="wiki-hero">
    <p class="selo">Wiki</p>
    <h1>Central de conhecimento</h1>
    <p class="wiki-descricao">
      Esta é a entrada principal da wiki. Aqui você encontra as informações do jogo organizadas por área, com dados, filtros e detalhes para consultar tudo de forma rápida.
    </p>
  </section>
  <section class="wiki-busca-global" data-wiki-global-search-root aria-labelledby="titulo-busca-global-wiki">
    <div>
      <p class="selo">Busca global</p>
      <h2 id="titulo-busca-global-wiki">Pesquise em todas as wikis</h2>
      <p>
        Procure por Pokémons, ataques, itens, NPCs, estruturas naturais, faixas de música e outros cartuchos e faixas sem entrar seção por seção.
      </p>
    </div>
    <CampoBuscaWiki
      data-wiki-global-search
      label="Pesquisar na wiki inteira"
      placeholder="Ex.: Pikachu, envenenado, pedra, boss, música, estrutura..."
    />
    <span class="wiki-busca-global-status" data-wiki-global-status></span>
  </section>
  <section class="secao" data-wiki-menu-secoes>
    <div class="cards wiki-cards-quinze">
      {secoes.map((secao) => <CardWiki {...secao} />)}
    </div>
  </section>
  <section class="secao wiki-busca-resultados-secao" data-wiki-global-results-section hidden>
    <div class="wiki-busca-resultados-topo">
      <h2>Resultados encontrados</h2>
      <p>A busca usa os cartuchos visuais das próprias wikis; faixas de música aparecem como linhas de áudio no meio dos resultados.</p>
    </div>
    <div class="wiki-busca-resultados" data-wiki-global-results aria-live="polite"></div>
    <div class="wiki-vazio wiki-busca-vazio" data-wiki-global-empty hidden>
      <strong>Nenhum resultado encontrado.</strong>
      <p>Tente pesquisar por outro nome, tipo, música, estrutura, NPC, item ou ataque.</p>
    </div>
  </section>
  <JsonPayload id="wiki-global-search-data" dados={{ itens: indiceBuscaWiki }} />
  <script>
    import { inicializarBuscaGlobalWiki } from "../../Codigo/WikiBuscaGlobalRuntime.js";
    inicializarBuscaGlobalWiki();
  </script>
</Layout>

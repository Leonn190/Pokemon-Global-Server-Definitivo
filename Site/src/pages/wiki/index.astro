---
import Layout from "../../Componentes/Layout.astro";
import CardWiki from "../../Componentes/CardWiki.astro";
import "../../Estilos/wiki.css";

const secoes = [
  {
    href: "/wiki/pokemons",
    emoji: "🐾",
    titulo: "Pokémons",
    texto: "Pokédex com busca, filtros, atributos, tipagens, raridades, linhagens e animações por frames.",
  },
  {
    href: "/wiki/itens",
    emoji: "🎒",
    titulo: "Itens",
    texto: "Consumíveis, doces, equipamentos, receitas e itens especiais do jogo.",
  },
  {
    href: "/wiki/ataques",
    emoji: "⚡",
    titulo: "Ataques",
    texto: "Ataques com custo, tipo, estilo, motor, foco, descrição e aprimoramento.",
  },
  {
    href: "/wiki/efeitos",
    emoji: "✨",
    titulo: "Efeitos",
    texto: "Status de Pokémon, climas, terrenos, sentido, passos base e descrições.",
  },
  {
    href: "/wiki/combate",
    emoji: "⚔️",
    titulo: "Combate",
    texto: "Regras de batalha, turnos, energia, dano, colisões, indicadores e animações.",
  },
  {
    href: "/wiki/dungeons",
    emoji: "🗺️",
    titulo: "Dungeons",
    texto: "Áreas fechadas, desafios especiais, progressão, recompensas e exploração por etapas.",
  },
  {
    href: "/wiki/equipaveis",
    emoji: "🛡️",
    titulo: "Equipáveis",
    texto: "Equipamentos, bônus, raridades, slots e efeitos aplicados aos Pokémons.",
  },
  {
    href: "/wiki/estadios",
    emoji: "🏟️",
    titulo: "Estádios",
    texto: "Estádios de cada tipo, progressão de respeito, insígnias, líderes e associados.",
  },
  {
    href: "/wiki/npcs",
    emoji: "🧍",
    titulo: "NPCs",
    texto: "Combatentes, vendedores, cargos, categorias, níveis, skins e equipes de Pokémon.",
  },
  {
    href: "/wiki/mundo",
    emoji: "🌍",
    titulo: "Mundo",
    texto: "Biomas, chunks, exploração, vilas, rotas, mapa e geração do mundo.",
  },
];
---

<Layout titulo="Wiki | Pokémon Global Server" descricao="Wiki provisória do Pokémon Global Server.">
  <section class="wiki-hero">
    <p class="selo">Wiki</p>
    <h1>Central de conhecimento</h1>
    <p class="wiki-descricao">
      Esta é a entrada principal da wiki. As seções usam os CSVs, regras e assets visuais do projeto para manter os dados próximos do funcionamento real do jogo.
    </p>
  </section>

  <section class="secao">
    <div class="cards wiki-cards-dez">
      {secoes.map((secao) => <CardWiki {...secao} />)}
    </div>
  </section>
</Layout>

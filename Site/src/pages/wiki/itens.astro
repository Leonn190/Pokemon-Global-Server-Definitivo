---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import {
  carregarItens,
  criarAssetsItens,
  resumoItens,
  MAPA_RARIDADES,
  OPCOES_VENDA,
} from "../../Codigo/ItemWikiDados.js";
import { normalizarChave } from "../../Codigo/PokemonWikiDados.js";
import { indexarPublicoPorNome } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const itens = carregarItens();
const resumo = resumoItens(itens);
const imagensItens = indexarPublicoPorNome(["Itens", "Objetos", "Pokebolas", "Pokébolas", "Poções", "Pocoes", "Frutas", "Ferramentas", "Recursos"]);
const assetsItens = criarAssetsItens(itens, imagensItens);
const estilos = [...new Map(itens.map((item) => [item.estiloBusca, item.estiloRotulo])).entries()].sort((a, b) => a[1].localeCompare(b[1], "pt-BR"));
const raridades = Object.entries(MAPA_RARIDADES).sort((a, b) => Number(a[0]) - Number(b[0]));
const payloadItens = JSON.stringify({ itens, assetsItens, resumo }).replace(/</g, "\\u003c");
---
<Layout
  titulo="Itens"
  descricao="Wiki de itens do Pokémon Global Server, com busca, filtros por estilo, raridade, baús, lojas e detalhes de cada item."
>
  <WikiTopo
    ativo="itens"
    titulo="Itens"
    tituloId="titulo-itens"
  />
  <section class="wiki-layout wiki-layout-pokedex">
    <div class="wiki-conteudo pokedex-app itens-app" data-itens-app>
      <section class="pokedex-toolbar itens-toolbar" aria-label="Ferramentas da wiki de itens">
        <label class="campo-busca">
          <span>Pesquisar</span>
          <input data-itens-search type="search" placeholder="Nome, código, estilo ou descrição..." autocomplete="off" />
        </label>
        <label>
          <span>Ordenar</span>
          <select data-itens-sort>
            <option value="ordem">Ordem oficial</option>
            <option value="nome">Alfabética</option>
            <option value="valor">Valor médio</option>
            <option value="raridade">Raridade</option>
            <option value="estilo">Estilo</option>
          </select>
        </label>
        <label>
          <span>Estilo</span>
          <select data-itens-style>
            <option value="">Todos</option>
            {estilos.map(([chave, rotulo]) => <option value={chave}>{rotulo}</option>)}
          </select>
        </label>
        <label>
          <span>Raridade</span>
          <select data-itens-rarity>
            <option value="">Todas</option>
            {raridades.map(([numero, dados]) => <option value={numero}>{dados.nome}</option>)}
          </select>
        </label>
        <label>
          <span>Baús</span>
          <select data-itens-chest>
            <option value="">Todos</option>
            <option value="s">Sim</option>
            <option value="n">Não</option>
          </select>
        </label>
        <label>
          <span>Venda</span>
          <select data-itens-sale>
            <option value="">Todos</option>
            {Object.entries(OPCOES_VENDA).map(([codigo, rotulo]) => <option value={codigo}>{rotulo}</option>)}
          </select>
        </label>
      </section>
      <section class="pokedex-status" aria-live="polite">
        <div>
          <strong data-itens-count>{resumo.quantidade}</strong>
          <span>resultados encontrados</span>
        </div>
        <div class="pokedex-acoes-status">
          <button class="botao fantasma compacto" type="button" data-itens-direction data-sort-direction="asc">Crescente</button>
          <button class="botao fantasma compacto" type="button" data-itens-clear>Limpar filtros</button>
        </div>
      </section>
      <section class="itens-grid" data-itens-grid aria-label="Lista de itens"></section>
      <div class="pokedex-vazio" data-itens-empty hidden>
        <strong>Nenhum item encontrado.</strong>
        <span>Tente remover algum filtro ou pesquisar por outro nome.</span>
      </div>
      <div class="pokedex-sentinel" data-itens-sentinel aria-hidden="true"></div>
    </div>
  </section>
  <aside class="item-detalhe pokemon-detalhe" data-item-detail hidden aria-live="polite">
    <div class="pokemon-detalhe-backdrop" data-item-close></div>
    <article class="pokemon-detalhe-card item-detalhe-card" role="dialog" aria-modal="true" aria-labelledby="item-detalhe-nome">
      <div class="pokemon-controles-detalhe" aria-label="Navegação do item aberto">
        <button class="pokemon-navegar" type="button" data-item-prev aria-label="Item anterior">‹</button>
        <button class="pokemon-navegar" type="button" data-item-next aria-label="Próximo item">›</button>
        <button class="pokemon-fechar" type="button" data-item-close aria-label="Fechar detalhes">×</button>
      </div>
      <div class="pokemon-detalhe-topo item-detalhe-topo">
        <div class="pokemon-palco-detalhe item-palco-detalhe">
          <div class="pokemon-brilho-detalhe"></div>
          <img data-item-image alt="" loading="lazy" decoding="async" />
        </div>
        <div class="pokemon-cabecalho-detalhe">
          <span class="codigo-pokemon" data-item-code>#000</span>
          <h2 id="item-detalhe-nome" data-item-name>Item</h2>
          <span class="raridade-pill" data-item-rarity>Comum</span>
          <p class="item-descricao-melhor" data-item-description></p>
        </div>
      </div>
      <section class="painel-detalhe item-info-painel">
        <h3>Informações</h3>
        <dl class="pokemon-info-lista" data-item-info></dl>
      </section>
    </article>
  </aside>
  <script id="itens-data" type="application/json" set:html={payloadItens}></script>
  <script>
    import { inicializarWikiItens } from "../../Codigo/ItensRuntime.js";
    inicializarWikiItens();
  </script>
</Layout>

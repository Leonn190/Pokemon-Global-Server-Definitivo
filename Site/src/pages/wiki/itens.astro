---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiCatalogoShell from "../../Componentes/WikiCatalogoShell.astro";
import CampoBuscaWiki from "../../Componentes/CampoBuscaWiki.astro";
import SelectFiltroWiki from "../../Componentes/SelectFiltroWiki.astro";
import ModalDetalhe from "../../Componentes/ModalDetalhe.astro";
import ModalControles from "../../Componentes/ModalControles.astro";
import DetalheTopo from "../../Componentes/DetalheTopo.astro";
import PainelDetalhe from "../../Componentes/PainelDetalhe.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  carregarItens,
  criarAssetsItens,
  indexarImagensItens,
  resumoItens,
  MAPA_RARIDADES,
  OPCOES_VENDA,
} from "../../Codigo/ItemWikiDados.js";
import { listarImagensPublicas } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const itens = carregarItens();
const resumo = resumoItens(itens);
const imagensItens = indexarImagensItens(listarImagensPublicas([
  "Itens",
  "Objetos",
  "Pokebolas",
  "Pokébolas",
  "Poções",
  "Pocoes",
  "Frutas",
  "Ferramentas",
  "Recursos",
  "Equipaveis",
  "Equipáveis",
]));
const assetsItens = criarAssetsItens(itens, imagensItens);
const estilos = [...new Map(itens.map((item) => [item.estiloBusca, item.estiloRotulo])).entries()].sort((a, b) => a[1].localeCompare(b[1], "pt-BR"));
const raridades = Object.entries(MAPA_RARIDADES).sort((a, b) => Number(a[0]) - Number(b[0]));
const payloadItens = { itens, assetsItens, resumo };
const opcoesOrdenacao = [
  ["ordem", "Ordem oficial"],
  ["nome", "Alfabética"],
  ["valor", "Valor médio"],
  ["raridade", "Raridade"],
  ["estilo", "Estilo"],
].map(([value, label]) => ({ value, label }));
const opcoesEstilo = [{ value: "", label: "Todos" }, ...estilos.map(([value, label]) => ({ value, label }))];
const opcoesRaridade = [{ value: "", label: "Todas" }, ...raridades.map(([value, dados]) => ({ value, label: dados.nome }))];
const opcoesBau = [{ value: "", label: "Todos" }, { value: "s", label: "Sim" }, { value: "n", label: "Não" }];
const opcoesVenda = [{ value: "", label: "Todos" }, ...Object.entries(OPCOES_VENDA).map(([value, label]) => ({ value, label }))];
---
<Layout
  titulo="Itens"
  descricao="Wiki de itens do Pokémon Global Server, com busca, filtros por estilo, raridade, baús, lojas e detalhes de cada item."
>
  <WikiTopo ativo="itens" titulo="Itens" tituloId="titulo-itens" />
  <WikiCatalogoShell
    appClass="itens-app"
    appAttrs={{ "data-itens-app": true }}
    toolbarClass="itens-toolbar"
    toolbarRotulo="Ferramentas da wiki de itens"
    quantidade={resumo.quantidade}
    countAttrs={{ "data-itens-count": true }}
    directionAttrs={{ "data-itens-direction": true }}
    clearAttrs={{ "data-itens-clear": true }}
    clearAriaLabel="Limpar todos os filtros de itens"
    gridClass="itens-grid"
    gridAttrs={{ "data-itens-grid": true }}
    gridRotulo="Lista de itens"
    vazioAttrs={{ "data-itens-empty": true }}
    vazioTitulo="Nenhum item encontrado."
    sentinelAttrs={{ "data-itens-sentinel": true }}
  >
    <Fragment slot="toolbar">
      <CampoBuscaWiki data-itens-search placeholder="Nome, código, estilo ou descrição..." />
      <SelectFiltroWiki data-itens-sort label="Ordenar" options={opcoesOrdenacao} />
      <SelectFiltroWiki data-itens-style label="Estilo" options={opcoesEstilo} />
      <SelectFiltroWiki data-itens-rarity label="Raridade" options={opcoesRaridade} />
      <SelectFiltroWiki data-itens-chest label="Baús" options={opcoesBau} />
      <SelectFiltroWiki data-itens-sale label="Venda" options={opcoesVenda} />
    </Fragment>
  </WikiCatalogoShell>
  <ModalDetalhe
    class="item-detalhe pokemon-detalhe"
    cardClass="pokemon-detalhe-card item-detalhe-card"
    labelledby="item-detalhe-nome"
    backdropAttrs={{ "data-item-close": true }}
    data-item-detail
  >
    <ModalControles
      rotulo="Navegação do item aberto"
      prevLabel="Item anterior"
      nextLabel="Próximo item"
      prevAttrs={{ "data-item-prev": true }}
      nextAttrs={{ "data-item-next": true }}
      closeAttrs={{ "data-item-close": true }}
    />
    <DetalheTopo
      class="item-detalhe-topo"
      palcoClass="item-palco-detalhe"
      imageAttrs={{ "data-item-image": true }}
      codeAttrs={{ "data-item-code": true }}
      nameAttrs={{ id: "item-detalhe-nome", "data-item-name": true }}
      nomeFallback="Item"
    >
      <span class="raridade-pill" data-item-rarity>Comum</span>
      <p class="item-descricao-melhor" data-item-description></p>
    </DetalheTopo>
    <PainelDetalhe titulo="Informações" class="item-info-painel">
      <dl class="pokemon-info-lista" data-item-info></dl>
    </PainelDetalhe>
  </ModalDetalhe>
  <JsonPayload id="itens-data" dados={payloadItens} />
  <script>
    import { inicializarWikiItens } from "../../Codigo/ItensRuntime.js";
    inicializarWikiItens();
  </script>
</Layout>

---
import Layout from "../../Componentes/Layout.astro";
import WikiMenu from "../../Componentes/WikiMenu.astro";
import "../../Estilos/wiki.css";
---

<Layout titulo="Mundo | Wiki Pokémon Global Server" descricao="Área de Mundo da wiki do Pokémon Global Server.">
  <section class="wiki-hero wiki-hero-pokedex" aria-labelledby="titulo-mundo">
    <h1 id="titulo-mundo">Mundo</h1>
  </section>

  <section class="pokedex-topo" aria-label="Navegação da wiki">
    <div class="pokedex-resumo wiki-placeholder-resumo" aria-label="Resumo da área">
      <article>
        <strong>0</strong>
        <span>Registros publicados</span>
      </article>
      <article>
        <strong>0</strong>
        <span>Categorias</span>
      </article>
      <article>
        <strong>Beta</strong>
        <span>Estado da wiki</span>
      </article>
    </div>

    <WikiMenu ativo="mundo" />
  </section>

  <section class="wiki-placeholder-card">
    <p class="selo">Wiki em expansão</p>
    <h2>Mundo ainda vai receber dados próprios.</h2>
    <p>Biomas, exploração, chunks, vilas, rotas, mapa, regiões e geração procedural.</p>
  </section>
</Layout>

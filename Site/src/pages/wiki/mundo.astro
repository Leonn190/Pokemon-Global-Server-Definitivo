---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiGrid from "../../Componentes/WikiGrid.astro";
import ModalDetalhe from "../../Componentes/ModalDetalhe.astro";
import ModalControles from "../../Componentes/ModalControles.astro";
import DetalheTopo from "../../Componentes/DetalheTopo.astro";
import PainelDetalhe from "../../Componentes/PainelDetalhe.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  carregarWikiMundo,
  criarAssetsEstruturas,
} from "../../Codigo/MundoWikiDados.js";
import { indexarPublicoPorNome } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const dadosMundo = carregarWikiMundo();
const { estruturas, biomas, resumo, captura } = dadosMundo;
const imagensEstruturas = [
  indexarPublicoPorNome(["Objetos", "Recursos/Objetos", "Recursos/Visual/Objetos", "Visual/Objetos", "Mundo/Objetos"]),
  indexarPublicoPorNome(["Mundo", "Recursos/Mundo", "Recursos/Visual/Mundo"]),
  indexarPublicoPorNome(["Ferramentas", "Itens", "Recursos", "Recursos/Itens", "Recursos/Visual/Itens"]),
];
const assetsEstruturas = criarAssetsEstruturas(estruturas, imagensEstruturas);
const estruturasPublicas = estruturas.map(({ subtipo, sprite, spriteArquivo, slug, origemEspecial, ...estrutura }) => estrutura);
const payloadMundo = { estruturas: estruturasPublicas, biomas, resumo, assetsEstruturas };
---
<Layout
  titulo="Mundo"
  descricao="Wiki de Mundo do Pokémon Global Server, com explicações da geração, biomas, vilas, estruturas naturais e dados ligados às regras do jogo."
>
  <WikiTopo ativo="mundo" titulo="Mundo" tituloId="titulo-mundo" />
  <main class="wiki-mundo" data-mundo-app aria-label="Conteúdo da wiki de mundo">
    <section class="mundo-intro">
      <article class="mundo-intro-principal">
        <p class="selo">Wiki de mundo</p>
        <h2>Exploração, biomas, estruturas naturais e localidades.</h2>
        <p>
          O mundo do Pokémon Global Server é grande, procedural e dividido em ambientes com identidades próprias.
          Esta área serve para explicar como o jogador deve entender o mapa: onde procurar recursos, como os biomas
          organizam a exploração e por que vilas, estádios e dungeons funcionam como pontos de referência durante a jornada.
        </p>
      </article>
    </section>
    <section class="mundo-blocos-texto" aria-label="Explicação geral do mundo">
      {[
        ["01", "Geração procedural", "O mapa nasce a partir de uma seed e combina água, terra, praias, campos, florestas, desertos, neve, regiões mágicas, áreas vulcânicas e pântanos. A ideia é que cada servidor tenha um mundo próprio, mas ainda reconhecível pelas mesmas regras de jogo."],
        ["02", "Biomas com propósito", "Cada bioma muda o tipo de recurso que o jogador encontra. Algumas estruturas aparecem em muitos ambientes, enquanto outras incentivam o jogador a viajar para regiões específicas do mapa."],
        ["03", "Localidades importantes", "Vilas, estádios e dungeons transformam o mapa em uma rede de objetivos. Elas ajudam o jogador a se orientar, planejar rotas e reconhecer regiões importantes além da coleta de recursos."],
      ].map(([numero, titulo, texto]) => (
        <article class="mundo-bloco-texto">
          <span class="mundo-numero">{numero}</span>
          <h3>{titulo}</h3>
          <p>{texto}</p>
        </article>
      ))}
    </section>
    <section class="mundo-secao" aria-labelledby="titulo-biomas-mundo">
      <div class="mundo-cabecalho-secao">
        <div>
          <p class="selo">Biomas</p>
          <h2 id="titulo-biomas-mundo">Ambientes que organizam a exploração</h2>
        </div>
        <p>
          Os biomas definem a sensação de cada região e ajudam a distribuir as estruturas naturais pelo mundo.
          Por isso, procurar um recurso também significa escolher qual ambiente explorar.
        </p>
      </div>
      <div class="mundo-biomas-grid" aria-label="Lista de biomas do mundo">
        {biomas.map((bioma) => (
          <article class="mundo-bioma-card">
            <h3>{bioma.nome}</h3>
            <p>{bioma.descricao}</p>
            <div class="mundo-bioma-info">
              <span>Terreno principal</span>
              <strong>{bioma.tileBase}</strong>
            </div>
            <div class="mundo-bioma-estruturas" aria-label={`Estruturas comuns em ${bioma.nome}`}>
              {bioma.principaisEstruturas.length
                ? bioma.principaisEstruturas.map((estrutura) => <span>{estrutura}</span>)
                : <span>Sem estruturas principais</span>}
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="mundo-secao mundo-captura" aria-labelledby="titulo-captura-mundo">
      <div class="mundo-cabecalho-secao">
        <div>
          <p class="selo">Captura</p>
          <h2 id="titulo-captura-mundo">Como a captura funciona no mundo</h2>
        </div>
        <p>
          A captura compara a dificuldade do Pokémon com o poder da tentativa. A fórmula vem de
          <code>Pokemons.toml</code>, então ajustes nas regras aparecem aqui sem precisar reescrever o site.
        </p>
      </div>
      <article class="mundo-captura-card">
        <p>
          Primeiro o jogo calcula a dificuldade usando atributos do Pokémon, nível e IV. Depois calcula o poder
          da tentativa com poder base, bola usada, frutas, bônus de bioma, maestria e captura crítica. Por fim,
          cada check usa <code>chance = clamp({captura.baseCheck} + (poder - dificuldade) × {captura.escalaDiferenca}, {captura.checkMin}, {captura.checkMax})</code>.
          A captura precisa passar em <strong>{captura.checksNecessarios}</strong> checks.
        </p>
        <div class="mundo-captura-dados" aria-label="Dados da regra de captura">
          <span>Frutas por tentativa: <strong>{captura.limiteFrutas}</strong></span>
          <span>Base do check: <strong>{captura.baseCheck}</strong></span>
          <span>Limite do check: <strong>{captura.checkMin}% a {captura.checkMax}%</strong></span>
          <span>Crítico: <strong>{captura.multiplicadorCritico}x</strong></span>
        </div>
      </article>
    </section>
    <section class="mundo-secao" aria-labelledby="titulo-estruturas-naturais">
      <div class="mundo-cabecalho-secao">
        <div>
          <p class="selo">Estruturas naturais</p>
          <h2 id="titulo-estruturas-naturais">Objetos encontrados no mundo</h2>
        </div>
        <p>
          Os cartuchos mostram o básico para consulta rápida. Ao abrir uma estrutura, a subtela mostra material,
          ferramenta, dureza, quantidade, coleta e locais de aparição sem expor campos internos de colisão.
        </p>
      </div>
      <WikiGrid class="itens-grid mundo-estrutura-grid" data-mundo-estruturas-grid rotulo="Lista de estruturas naturais" />
    </section>
  </main>
  <ModalDetalhe
    class="item-detalhe pokemon-detalhe"
    cardClass="pokemon-detalhe-card item-detalhe-card mundo-detalhe-card"
    labelledby="mundo-detalhe-nome"
    backdropAttrs={{ "data-mundo-close": true }}
    data-mundo-detail
  >
    <ModalControles
      rotulo="Navegação da estrutura aberta"
      prevLabel="Estrutura anterior"
      nextLabel="Próxima estrutura"
      prevAttrs={{ "data-mundo-prev": true }}
      nextAttrs={{ "data-mundo-next": true }}
      closeAttrs={{ "data-mundo-close": true }}
    />
    <DetalheTopo
      class="item-detalhe-topo mundo-detalhe-topo"
      palcoClass="item-palco-detalhe mundo-palco-detalhe"
      cabecalhoClass="mundo-cabecalho-detalhe"
      imageAttrs={{ "data-mundo-image": true }}
      codeAttrs={{ "data-mundo-code": true }}
      nameAttrs={{ id: "mundo-detalhe-nome", "data-mundo-name": true }}
      nomeFallback="Estrutura"
    >
      <p class="item-descricao-melhor" data-mundo-description></p>
      <div class="mundo-detalhe-biomas" data-mundo-biomes aria-label="Locais de aparição"></div>
    </DetalheTopo>
    <PainelDetalhe titulo="Informações" class="item-info-painel">
      <dl class="pokemon-info-lista" data-mundo-info></dl>
    </PainelDetalhe>
  </ModalDetalhe>
  <JsonPayload id="mundo-data" dados={payloadMundo} />
  <script>
    import { inicializarWikiMundo } from "../../Codigo/MundoRuntime.js";
    inicializarWikiMundo();
  </script>
</Layout>

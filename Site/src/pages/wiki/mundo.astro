---
import Layout from "../../Componentes/Layout.astro";
import "../../Estilos/wiki.css";
---

<Layout titulo="Mundo | Wiki PGS" descricao="Página provisória de Mundo da wiki.">
  <section class="wiki-hero">
    <p class="selo">Wiki / Mundo</p>
    <h1>Mundo</h1>
    <p class="wiki-descricao">
      Página futura para biomas, exploração, chunks, vilas, rotas, mapa, regiões e geração procedural.
    </p>
  </section>

  <section class="wiki-layout">
    <aside class="wiki-menu-lateral">
      <a href="/wiki/pokemons">Pokémons</a>
      <a href="/wiki/itens">Itens</a>
      <a href="/wiki/efeitos">Efeitos</a>
      <a href="/wiki/estadios">Estádios</a>
      <a class="ativo" href="/wiki/mundo">Mundo</a>
    </aside>

    <div class="wiki-conteudo">
      <div class="wiki-grid">
        <article class="bloco-info">
          <h2>Exploração</h2>
          <p>Espaço para explicar chunks, minimapa, mapa grande, descoberta de regiões e cache de imagens.</p>
          <div class="placeholder-lista">
            <div class="placeholder-item"><strong>Biomas</strong><span>campo, floresta, deserto...</span></div>
            <div class="placeholder-item"><strong>Rotas</strong><span>ligações entre vilas</span></div>
            <div class="placeholder-item"><strong>Regiões</strong><span>divisões do mundo</span></div>
          </div>
        </article>

        <article class="bloco-info">
          <h2>Geração</h2>
          <p>Depois você pode documentar regras de terreno, precedência de tiles e estruturas naturais.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import {
  carregarNpcs,
  criarAssetsNpcs,
  indexarSkinsNpcs,
  resumoNpcs,
} from "../../Codigo/NpcsWikiDados.js";
import {
  ATRIBUTOS_BASE,
  carregarPokemons,
  criarAssetsPokemons,
  indexarArquivosPorNome,
  normalizarChave,
} from "../../Codigo/PokemonWikiDados.js";
import "../../Estilos/wiki.css";

const npcs = carregarNpcs();
const resumo = resumoNpcs(npcs);
const pokemons = carregarPokemons();

const skinsBrutas = import.meta.glob("@recursos/Visual/Skins/**/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP,gif,GIF}", {
  eager: true,
  query: "?url",
  import: "default",
});
const imagensPokemons = import.meta.glob("@recursos/Visual/Pokemons/Imagens/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP,gif,GIF}", {
  eager: true,
  query: "?url",
  import: "default",
});
const iconesTiposBrutos = import.meta.glob("@recursos/Visual/Icones/Tipos/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP,gif,GIF}", {
  eager: true,
  query: "?url",
  import: "default",
});
const iconesAtributosBrutos = import.meta.glob("@recursos/Visual/Icones/Atributos/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP,gif,GIF}", {
  eager: true,
  query: "?url",
  import: "default",
});

const skinsNpcs = indexarSkinsNpcs(skinsBrutas);
const assetsNpcs = criarAssetsNpcs(npcs, skinsNpcs);
const imagensPorNome = indexarArquivosPorNome(imagensPokemons);
const iconesTipos = indexarArquivosPorNome(iconesTiposBrutos);
const iconesAtributos = indexarArquivosPorNome(iconesAtributosBrutos);
const assetsPokemons = criarAssetsPokemons(pokemons, imagensPorNome);
const payloadNpcs = JSON.stringify({ npcs, assetsNpcs, resumo, iconesTipos }).replace(/</g, "\\u003c");
const payloadPokedex = JSON.stringify({ pokemons, assetsPokemons, iconesTipos, iconesAtributos, atributosBase: ATRIBUTOS_BASE }).replace(/</g, "\\u003c");
---

<Layout
  titulo="NPCs | Wiki Pokémon Global Server"
  descricao="Wiki de NPCs do Pokémon Global Server, com combatentes, vendedores, cargos, categorias e equipes de Pokémon."
>
  <WikiTopo
    ativo="npcs"
    titulo="NPCs"
    tituloId="titulo-npcs"
    ariaResumo="Resumo dos NPCs"
    resumoClasse="resumo-tres"
    resumo={[{ valor: resumo.quantidade, rotulo: "NPCs registrados" }, { valor: resumo.combatentes, rotulo: "Combatentes" }, { valor: resumo.vendedores, rotulo: "Vendedores" }]}
  />

  <section class="wiki-layout wiki-layout-pokedex">
    <div class="wiki-conteudo pokedex-app npcs-app" data-npcs-app>
      <section class="pokedex-toolbar npcs-toolbar" aria-label="Ferramentas da wiki de NPCs">
        <label class="campo-busca">
          <span>Pesquisar</span>
          <input data-npcs-search type="search" placeholder="Nome, código, categoria, cargo, estádio ou Pokémon..." autocomplete="off" />
        </label>

        <label>
          <span>Ordenar</span>
          <select data-npcs-sort>
            <option value="ordem">Ordem oficial</option>
            <option value="nome">Alfabética</option>
            <option value="nivel">Nível</option>
            <option value="tipo">Tipo</option>
            <option value="cargo">Cargo</option>
            <option value="categoria">Categoria</option>
          </select>
        </label>

        <label>
          <span>Tipo</span>
          <select data-npcs-kind>
            <option value="">Todos</option>
            <option value="combatente">Combatente</option>
            <option value="vendedor">Vendedor</option>
          </select>
        </label>

        <label data-npcs-vendor-only hidden>
          <span>Categoria</span>
          <select data-npcs-category>
            <option value="">Todas</option>
            {resumo.categorias.map((categoria) => <option value={normalizarChave(categoria)}>{categoria}</option>)}
          </select>
        </label>

        <label data-npcs-combat-only hidden>
          <span>Cargo</span>
          <select data-npcs-role>
            <option value="">Todos</option>
            {resumo.cargos.map((cargo) => <option value={normalizarChave(cargo)}>{cargo}</option>)}
          </select>
        </label>
      </section>

      <section class="filtros-rapidos filtros-tipos-icones filtros-tipos-npcs" data-npcs-type-filters hidden aria-label="Filtro por tipagem de combatentes">
        {resumo.tipagens.map((tipo) => (
          <button class="tipo-chip tipo-chip-icone" type="button" data-npcs-type-chip={normalizarChave(tipo)} title={tipo} aria-label={`Filtrar por ${tipo}`} aria-pressed="false">
            <span class="tipo-icone-mini">
              {iconesTipos[normalizarChave(tipo)] ? <img src={iconesTipos[normalizarChave(tipo)]} alt="" loading="eager" decoding="async" /> : null}
            </span>
          </button>
        ))}
      </section>

      <section class="pokedex-status" aria-live="polite">
        <div>
          <strong data-npcs-count>{resumo.quantidade}</strong>
          <span>resultados encontrados</span>
        </div>
        <div class="pokedex-acoes-status">
          <button class="botao fantasma compacto" type="button" data-npcs-direction data-sort-direction="asc">Crescente</button>
          <button class="botao fantasma compacto" type="button" data-npcs-clear>Limpar filtros</button>
        </div>
      </section>

      <section class="itens-grid npcs-grid" data-npcs-grid aria-label="Lista de NPCs"></section>

      <div class="pokedex-vazio" data-npcs-empty hidden>
        <strong>Nenhum NPC encontrado.</strong>
        <span>Tente remover algum filtro ou pesquisar por outro nome.</span>
      </div>

      <div class="pokedex-sentinel" data-npcs-sentinel aria-hidden="true"></div>
    </div>
  </section>

  <aside class="item-detalhe pokemon-detalhe" data-npc-detail hidden aria-live="polite">
    <div class="pokemon-detalhe-backdrop" data-npc-close></div>
    <article class="pokemon-detalhe-card item-detalhe-card npc-detalhe-card" role="dialog" aria-modal="true" aria-labelledby="npc-detalhe-nome">
      <div class="pokemon-controles-detalhe" aria-label="Navegação do NPC aberto">
        <button class="pokemon-navegar" type="button" data-npc-prev aria-label="NPC anterior">‹</button>
        <button class="pokemon-navegar" type="button" data-npc-next aria-label="Próximo NPC">›</button>
        <button class="pokemon-fechar" type="button" data-npc-close aria-label="Fechar detalhes">×</button>
      </div>

      <div class="pokemon-detalhe-topo item-detalhe-topo npc-detalhe-topo">
        <div class="pokemon-palco-detalhe item-palco-detalhe npc-palco-detalhe">
          <div class="pokemon-brilho-detalhe"></div>
          <img data-npc-image alt="" loading="lazy" decoding="async" />
        </div>

        <div class="pokemon-cabecalho-detalhe npc-cabecalho-detalhe">
          <span class="codigo-pokemon" data-npc-code>#000</span>
          <h2 id="npc-detalhe-nome" data-npc-name>NPC</h2>
          <div class="pokemon-tags" data-npc-tags></div>
        </div>
      </div>

      <section class="painel-detalhe item-info-painel">
        <h3>Informações</h3>
        <dl class="pokemon-info-lista" data-npc-info></dl>
      </section>

      <section class="painel-detalhe item-info-painel dungeon-pokemon-painel" data-npc-team-panel hidden>
        <h3>Equipe Pokémon</h3>
        <div class="dungeon-pokemon-grid" data-npc-team></div>
      </section>
    </article>
  </aside>

  <aside class="pokemon-detalhe dungeon-pokemon-detalhe" data-npc-pokemon-detail hidden aria-live="polite">
    <div class="pokemon-detalhe-backdrop" data-pokemon-close></div>
    <article class="pokemon-detalhe-card" role="dialog" aria-modal="true" aria-labelledby="pokemon-npc-detalhe-nome">
      <div class="pokemon-controles-detalhe" aria-label="Navegação do Pokémon aberto">
        <button class="pokemon-navegar" type="button" data-pokemon-prev aria-label="Pokémon anterior">‹</button>
        <button class="pokemon-navegar" type="button" data-pokemon-next aria-label="Próximo Pokémon">›</button>
        <button class="pokemon-fechar" type="button" data-pokemon-close aria-label="Fechar detalhes">×</button>
      </div>

      <div class="pokemon-detalhe-topo">
        <div class="pokemon-palco-detalhe">
          <div class="pokemon-brilho-detalhe"></div>
          <img data-detail-image alt="" loading="lazy" decoding="async" />
          <div class="pokemon-sem-imagem" data-detail-fallback hidden></div>
        </div>

        <div class="pokemon-cabecalho-detalhe">
          <span class="codigo-pokemon" data-detail-code>#000</span>
          <h2 id="pokemon-npc-detalhe-nome" data-detail-name>Pokémon</h2>
          <div class="pokemon-tags" data-detail-tags></div>
          <p data-detail-summary hidden></p>
        </div>
      </div>

      <div class="pokemon-detalhe-grid">
        <section class="painel-detalhe">
          <h3>Atributos básicos</h3>
          <div class="barras-atributos" data-detail-stats></div>
        </section>

        <section class="painel-detalhe">
          <h3>Informações</h3>
          <dl class="pokemon-info-lista" data-detail-info></dl>
        </section>
      </div>

      <section class="painel-detalhe painel-linhagem" data-detail-line-panel>
        <div class="painel-titulo-linha">
          <h3>Linhagem / evoluções</h3>
          <span data-detail-line-count></span>
        </div>
        <div class="linhagem-lista" data-detail-line></div>
      </section>
    </article>
  </aside>

  <script id="npcs-data" type="application/json" set:html={payloadNpcs}></script>
  <script id="npcs-pokedex-data" type="application/json" set:html={payloadPokedex}></script>
  <script>
    import { inicializarWikiNpcs } from "../../Codigo/NpcsRuntime.js";
    inicializarWikiNpcs();
  </script>
</Layout>

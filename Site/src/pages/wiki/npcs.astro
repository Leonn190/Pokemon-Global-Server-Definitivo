---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiCatalogoShell from "../../Componentes/WikiCatalogoShell.astro";
import CampoBuscaWiki from "../../Componentes/CampoBuscaWiki.astro";
import SelectFiltroWiki from "../../Componentes/SelectFiltroWiki.astro";
import FiltroTipoIcones from "../../Componentes/FiltroTipoIcones.astro";
import NpcDetalheModal from "../../Componentes/NpcDetalheModal.astro";
import PokemonDetalheModal from "../../Componentes/PokemonDetalheModal.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  carregarNpcs,
  criarAssetsNpcs,
  indexarSkinsNpcs,
  resumoNpcs,
} from "../../Codigo/NpcsWikiDados.js";
import {
  ATRIBUTOS_BASE,
  carregarPokemons,
  criarAssetsPokemons,
  normalizarChave,
} from "../../Codigo/PokemonWikiDados.js";
import { indexarPublicoPorNome, listarImagensPublicas } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const npcs = carregarNpcs();
const resumo = resumoNpcs(npcs);
const pokemons = carregarPokemons();
const skinsNpcs = indexarSkinsNpcs(listarImagensPublicas("Skins"));
const assetsNpcs = criarAssetsNpcs(npcs, skinsNpcs);
const imagensPorNome = indexarPublicoPorNome("Imagens");
const iconesTipos = indexarPublicoPorNome("Tipos");
const iconesAtributos = indexarPublicoPorNome("Atributos");
const assetsPokemons = criarAssetsPokemons(pokemons, imagensPorNome);
const payloadNpcs = { npcs, assetsNpcs, resumo, iconesTipos };
const payloadPokedex = { pokemons, assetsPokemons, iconesTipos, iconesAtributos, atributosBase: ATRIBUTOS_BASE };
const opcoesOrdenacao = [
  ["ordem", "Ordem oficial"],
  ["nome", "Alfabética"],
  ["nivel", "Nível"],
  ["tipo", "Tipo"],
  ["cargo", "Cargo"],
  ["categoria", "Categoria"],
].map(([value, label]) => ({ value, label }));
const opcoesTipo = [{ value: "", label: "Todos" }, { value: "combatente", label: "Combatente" }, { value: "vendedor", label: "Vendedor" }];
const opcoesCategoria = [{ value: "", label: "Todas" }, ...resumo.categorias.map((categoria) => ({ value: normalizarChave(categoria), label: categoria }))];
const opcoesCargo = [{ value: "", label: "Todos" }, ...resumo.cargos.map((cargo) => ({ value: normalizarChave(cargo), label: cargo }))];
---
<Layout
  titulo="NPCs"
  descricao="Wiki de NPCs do Pokémon Global Server, com combatentes, vendedores, cargos, categorias e equipes de Pokémon."
>
  <WikiTopo ativo="npcs" titulo="NPCs" tituloId="titulo-npcs" />
  <WikiCatalogoShell
    appClass="npcs-app"
    appAttrs={{ "data-npcs-app": true }}
    toolbarClass="npcs-toolbar"
    toolbarRotulo="Ferramentas da wiki de NPCs"
    quantidade={resumo.quantidade}
    countAttrs={{ "data-npcs-count": true }}
    directionAttrs={{ "data-npcs-direction": true }}
    clearAttrs={{ "data-npcs-clear": true }}
    clearAriaLabel="Limpar todos os filtros de NPCs"
    gridClass="itens-grid npcs-grid"
    gridAttrs={{ "data-npcs-grid": true }}
    gridRotulo="Lista de NPCs"
    vazioAttrs={{ "data-npcs-empty": true }}
    vazioTitulo="Nenhum NPC encontrado."
    sentinelAttrs={{ "data-npcs-sentinel": true }}
  >
    <Fragment slot="toolbar">
      <CampoBuscaWiki data-npcs-search placeholder="Nome, código, categoria, cargo, estádio ou Pokémon..." />
      <SelectFiltroWiki data-npcs-sort label="Ordenar" options={opcoesOrdenacao} />
      <SelectFiltroWiki data-npcs-kind label="Tipo" options={opcoesTipo} />
      <SelectFiltroWiki data-npcs-category label="Categoria" options={opcoesCategoria} />
      <SelectFiltroWiki data-npcs-role label="Cargo" options={opcoesCargo} />
    </Fragment>
    <FiltroTipoIcones
      slot="after-toolbar"
      itens={resumo.tipagens}
      icones={iconesTipos}
      dataAttr="data-npcs-type-chip"
      class="filtros-tipos-npcs"
      rotulo="Filtro por tipagem de combatentes"
      ariaPressed
    />
  </WikiCatalogoShell>
  <NpcDetalheModal labelledby="npc-detalhe-nome" detailAttrs={{ "data-npc-detail": true }} />
  <PokemonDetalheModal
    labelledby="pokemon-npc-detalhe-nome"
    class="pokemon-detalhe dungeon-pokemon-detalhe"
    detailAttrs={{ "data-npc-pokemon-detail": true }}
  />
  <JsonPayload id="npcs-data" dados={payloadNpcs} />
  <JsonPayload id="npcs-pokedex-data" dados={payloadPokedex} />
  <script>
    import { inicializarWikiNpcs } from "../../Codigo/NpcsRuntime.js";
    inicializarWikiNpcs();
  </script>
</Layout>

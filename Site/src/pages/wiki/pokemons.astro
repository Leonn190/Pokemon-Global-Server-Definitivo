---
import Layout from "../../Componentes/Layout.astro";
import WikiTopo from "../../Componentes/WikiTopo.astro";
import WikiCatalogoShell from "../../Componentes/WikiCatalogoShell.astro";
import CampoBuscaWiki from "../../Componentes/CampoBuscaWiki.astro";
import SelectFiltroWiki from "../../Componentes/SelectFiltroWiki.astro";
import FiltroTipoIcones from "../../Componentes/FiltroTipoIcones.astro";
import PokemonDetalheModal from "../../Componentes/PokemonDetalheModal.astro";
import JsonPayload from "../../Componentes/JsonPayload.astro";
import {
  ATRIBUTOS_BASE,
  ATRIBUTOS_REGULARES,
  carregarPokemons,
  criarAssetsPokemons,
  normalizarChave,
  resumoPokemons,
} from "../../Codigo/PokemonWikiDados.js";
import { indexarPublicoPorNome } from "../../Codigo/AssetsPublicos.js";
import "../../Estilos/wiki.css";
const pokemons = carregarPokemons();
const resumo = resumoPokemons(pokemons);
const imagensPorNome = indexarPublicoPorNome("Imagens");
const iconesTipos = indexarPublicoPorNome("Tipos");
const iconesAtributos = indexarPublicoPorNome("Atributos");
const assetsPokemons = criarAssetsPokemons(pokemons, imagensPorNome);
const tiposVisiveis = resumo.tipos;
const payloadPokedex = {
  pokemons,
  assetsPokemons,
  iconesTipos,
  iconesAtributos,
  atributosBase: ATRIBUTOS_BASE,
  resumo,
};
const opcoesOrdenacao = [
  ["ordem", "Ordem oficial"],
  ["nome", "Alfabética"],
  ["vida", "Vida"],
  ["atk", "Atk"],
  ["def", "Def"],
  ["spa", "SpA"],
  ["spd", "SpD"],
  ["vel", "Vel"],
  ["mag", "Mag"],
  ["per", "Per"],
  ["ene", "Ene"],
  ["int", "Int"],
  ["crd", "CrD"],
  ["crc", "CrC"],
  ["total", "Total"],
  ["altura", "Altura"],
  ["peso", "Peso"],
].map(([value, label]) => ({ value, label }));
const opcoesFoco = [{ value: "", label: "Todos" }, ...ATRIBUTOS_REGULARES.map((foco) => ({ value: normalizarChave(foco), label: foco }))];
const opcoesGrupo = [{ value: "", label: "Todos" }, ...resumo.grupos.map((grupo) => ({ value: normalizarChave(grupo), label: grupo }))];
const opcoesRaridade = [{ value: "", label: "Todas" }, ...resumo.raridades.map((raridade) => ({ value: normalizarChave(raridade), label: raridade }))];
---
<Layout
  titulo="Pokémons"
  descricao="Wiki de Pokémons do Pokémon Global Server, com busca, filtros por foco, filtros por tipos, atributos, raridade, linhagem e imagens principais."
>
  <WikiTopo ativo="pokemons" titulo="Pokémons" tituloId="titulo-pokedex" />
  <WikiCatalogoShell
    appAttrs={{ "data-pokedex-app": true }}
    toolbarRotulo="Ferramentas da wiki de Pokémons"
    quantidade={resumo.quantidade}
    countAttrs={{ "data-pokedex-count": true }}
    directionAttrs={{ "data-pokedex-direction": true }}
    clearAttrs={{ "data-pokedex-clear": true }}
    clearAriaLabel="Limpar todos os filtros de Pokémons"
    gridClass="pokedex-grid"
    gridAttrs={{ "data-pokedex-grid": true }}
    gridRotulo="Lista de Pokémons"
    vazioAttrs={{ "data-pokedex-empty": true }}
    vazioTitulo="Nenhum Pokémon encontrado."
    sentinelAttrs={{ "data-pokedex-sentinel": true }}
  >
    <Fragment slot="toolbar">
      <CampoBuscaWiki data-pokedex-search placeholder="Nome, código, tipo ou grupo..." />
      <SelectFiltroWiki data-pokedex-sort label="Ordenar" options={opcoesOrdenacao} />
      <SelectFiltroWiki data-pokedex-focus label="Foco" options={opcoesFoco} />
      <SelectFiltroWiki data-pokedex-group label="Grupo" options={opcoesGrupo} />
      <SelectFiltroWiki data-pokedex-rarity label="Raridade" options={opcoesRaridade} />
    </Fragment>
    <FiltroTipoIcones
      slot="after-toolbar"
      itens={tiposVisiveis}
      icones={iconesTipos}
      dataAttr="data-type-chip"
      rotulo="Filtros por tipo. Selecione até três tipos."
    />
  </WikiCatalogoShell>
  <PokemonDetalheModal labelledby="pokemon-detalhe-nome" detailAttrs={{ "data-pokemon-detail": true }} />
  <JsonPayload id="pokedex-data" dados={payloadPokedex} />
  <script>
    import { inicializarPokedex } from "../../Codigo/PokedexRuntime.js";
    inicializarPokedex();
  </script>
</Layout>
